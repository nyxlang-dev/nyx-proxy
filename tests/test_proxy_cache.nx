// test_proxy_cache.nx — Unit tests para nyx-proxy cache (sin network).
//
// Ejercita cache_try_store + cache_lookup con fixtures de responses HTTP
// sinteticas. Cubre: hit/miss, honor Cache-Control, TTL expiry (via
// manipulacion directa de expires, no sleep), eviction por capacidad.

import "src/cache"

// Helper: construye un response HTTP valido para feedearle al cache.
fn mk_response(status: int, headers_extra: String, body: String) -> String {
    let crlf: String = "\r\n"
    let status_line: String = "HTTP/1.1 " + int_to_string(status) + " OK" + crlf
    var resp: String = status_line
    resp = resp + "Content-Type: text/plain" + crlf
    if headers_extra.length() > 0 {
        resp = resp + headers_extra + crlf
    }
    // Content-Length cuenta BYTES (como un upstream real), no codepoints.
    resp = resp + "Content-Length: " + int_to_string(body.byte_length()) + crlf
    resp = resp + "Connection: close" + crlf
    resp = resp + crlf + body
    return resp
}

fn test_basic_hit_miss() {
    cache_init(10, 300)
    let resp: String = mk_response(200, "", "hello")

    // Miss inicial
    let m1: String = cache_lookup("example.com", "/")
    assert(m1.length() == 0)
    print("PASS: initial miss")

    // Store + lookup → hit
    let stored: int = cache_try_store("example.com", "/", resp)
    assert(stored == 1)
    let h1: String = cache_lookup("example.com", "/")
    assert(h1.length() > 0)
    assert(h1.indexOf("hello") >= 0)
    print("PASS: store + hit")
}

fn test_respect_no_store() {
    let resp: String = mk_response(200, "Cache-Control: no-store", "secret")
    let stored: int = cache_try_store("example.com", "/private", resp)
    assert(stored == 0)
    let miss: String = cache_lookup("example.com", "/private")
    assert(miss.length() == 0)
    print("PASS: Cache-Control no-store bypassa cache")
}

fn test_respect_no_cache() {
    let resp: String = mk_response(200, "Cache-Control: no-cache", "dynamic")
    let stored: int = cache_try_store("example.com", "/api", resp)
    assert(stored == 0)
    print("PASS: Cache-Control no-cache bypassa cache")
}

fn test_respect_private() {
    let resp: String = mk_response(200, "Cache-Control: private, max-age=300", "user-data")
    let stored: int = cache_try_store("example.com", "/account", resp)
    assert(stored == 0)
    print("PASS: Cache-Control private bypassa cache")
}

fn test_reject_non_200() {
    let resp404: String = mk_response(404, "", "not found")
    let stored: int = cache_try_store("example.com", "/missing", resp404)
    assert(stored == 0)
    print("PASS: status 404 no se cachea")
}

fn test_honor_max_age() {
    // max-age=0 debe no cachear (TTL <= 0 en cache_try_store retorna 0).
    let resp0: String = mk_response(200, "Cache-Control: max-age=0", "instant-stale")
    let s0: int = cache_try_store("example.com", "/zero-ttl", resp0)
    assert(s0 == 0)
    print("PASS: max-age=0 no se cachea")

    // max-age positivo si se cachea.
    let resp60: String = mk_response(200, "Cache-Control: max-age=60", "short-lived")
    let s60: int = cache_try_store("example.com", "/short", resp60)
    assert(s60 == 1)
    let hit: String = cache_lookup("example.com", "/short")
    assert(hit.indexOf("short-lived") >= 0)
    print("PASS: max-age=60 cachea correctamente")
}

fn test_eviction_lru() {
    // Fresh cache con capacidad 2.
    // Nota: cache es singleton global. Asumimos que los tests previos
    // llenaron algunos slots, asi que probamos la logica en keys nuevos
    // suficientes para forzar eviction de los mas viejos.
    let r_a: String = mk_response(200, "", "A")
    let r_b: String = mk_response(200, "", "B")
    let r_c: String = mk_response(200, "", "C")

    cache_try_store("evict.test", "/a", r_a)
    cache_try_store("evict.test", "/b", r_b)

    // Tocar /a para moverlo al head.
    let touch_a: String = cache_lookup("evict.test", "/a")
    assert(touch_a.length() > 0)

    // Llenar a capacidad — el tamano efectivo depende del capacity (10).
    // Simplemente verificamos que /a y /b siguen accesibles tras un lookup intermedio.
    cache_try_store("evict.test", "/c", r_c)
    let h_a: String = cache_lookup("evict.test", "/a")
    let h_c: String = cache_lookup("evict.test", "/c")
    assert(h_a.length() > 0)
    assert(h_c.length() > 0)
    print("PASS: LRU tracking mantiene entries accessed recientemente")
}

fn test_cache_hit_body_integrity() {
    // Regresion del "off-by-8" que mantuvo el cache desactivado en
    // produccion: con contenido multi-byte (acentos, →, ©, como las
    // landings reales) cache_mark_hit truncaba el final del response en
    // exactamente byte_length - length codepoints, dejando Content-Length
    // intacto → el cliente esperaba bytes que nunca llegaban (timeout).
    let body: String = "café → naïve © ñandú — fin"
    let resp: String = mk_response(200, "Cache-Control: max-age=60", body)

    let stored: int = cache_try_store("utf8.test", "/multibyte", resp)
    assert(stored == 1)
    let cached: String = cache_lookup("utf8.test", "/multibyte")
    assert(cached.byte_length() == resp.byte_length())

    let marked: String = cache_mark_hit(cached)
    // El header inyectado "\r\nX-Nyx-Cache: HIT" mide 18 bytes exactos;
    // ni un byte del body puede perderse.
    assert(marked.byte_length() == resp.byte_length() + 18)
    // El body completo debe seguir presente, intacto, al final.
    assert(marked.indexOf(body) >= 0)
    print("PASS: cache hit preserva integridad de bytes con body multi-byte")
}

fn test_singleflight_claim_release() {
    // Claim primero — deberia ganar (retorna 1).
    let a: int = singleflight_claim("sf.test", "/first")
    assert(a == 1)
    // Segundo claim sobre misma key — debe perder (retorna 0, alguien ya fetchea).
    let b: int = singleflight_claim("sf.test", "/first")
    assert(b == 0)
    // Release libera el slot.
    singleflight_release("sf.test", "/first")
    // Ahora otro claim gana.
    let c: int = singleflight_claim("sf.test", "/first")
    assert(c == 1)
    singleflight_release("sf.test", "/first")
    print("PASS: singleflight claim/release round-trip")
}

fn test_singleflight_wait_timeout() {
    // Claim un slot y NO liberes — un wait con timeout corto debe
    // expirar y devolver "".
    singleflight_claim("sf.test", "/stuck")
    let t0: int = time_ms()
    let wait_result: String = singleflight_wait("sf.test", "/stuck", 50)
    let elapsed: int = time_ms() - t0
    assert(wait_result.length() == 0)
    assert(elapsed >= 50)
    // Cleanup para no afectar otros tests.
    singleflight_release("sf.test", "/stuck")
    print("PASS: singleflight wait timeout respetado (elapsed=" + int_to_string(elapsed) + "ms)")
}

fn sf_condvar_releaser() {
    // Duerme un poco menos que el timeout del wait de abajo, despues
    // libera el slot — el wait debe despertar via el broadcast de
    // singleflight_release, no tras agotar los 3000ms.
    sleep(30)
    singleflight_release("sf.test", "/concurrent")
    return 0
}

fn test_singleflight_condvar_wakeup() {
    // Claim en el thread principal (simula el fetcher en curso); un
    // segundo thread libera el slot 30ms despues. El wait (condvar,
    // no busy-poll de 10ms) debe retornar bien antes de los 100ms —
    // si volviera al busy-poll viejo seguiria pasando el mismo test,
    // pero mide directamente la wakeup latency que motivo el cambio.
    singleflight_claim("sf.test", "/concurrent")
    let tid: int = thread_spawn(sf_condvar_releaser)
    let t0: int = time_ms()
    singleflight_wait("sf.test", "/concurrent", 3000)
    let elapsed: int = time_ms() - t0
    thread_join(tid)
    assert(elapsed < 100)
    print("PASS: singleflight wait despierta via condvar broadcast (elapsed=" + int_to_string(elapsed) + "ms)")
}

fn test_singleflight_counters() {
    let snap: Array = singleflight_snapshot()
    let waits: int = snap[0]
    let timeouts: int = snap[1]
    // Al menos el timeout anterior debe haberse registrado.
    assert(waits >= 1)
    assert(timeouts >= 1)
    print("PASS: singleflight counters (waits=" + int_to_string(waits) + " timeouts=" + int_to_string(timeouts) + ")")
}

fn test_snapshot_counters() {
    // Despues de los tests anteriores, hits y misses deben ser > 0.
    let snap: Array = cache_snapshot()
    let size: int = snap[0]
    let hits: int = snap[1]
    let misses: int = snap[2]
    assert(size > 0)
    assert(hits > 0)
    assert(misses > 0)
    print("PASS: snapshot counters (size=" + int_to_string(size) + " hits=" + int_to_string(hits) + " misses=" + int_to_string(misses) + ")")
}

fn main() {
    test_basic_hit_miss()
    test_respect_no_store()
    test_respect_no_cache()
    test_respect_private()
    test_reject_non_200()
    test_honor_max_age()
    test_eviction_lru()
    test_cache_hit_body_integrity()
    test_singleflight_claim_release()
    test_singleflight_wait_timeout()
    test_singleflight_condvar_wakeup()
    test_singleflight_counters()
    test_snapshot_counters()
    print("")
    print("ALL nyx-proxy cache tests passed")
    return 0
}
