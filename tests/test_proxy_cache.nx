// test_proxy_cache.nx — Unit tests para nyx-proxy cache (sin network).
//
// Ejercita cache_try_store + cache_lookup con fixtures de responses HTTP
// sinteticas. Cubre: hit/miss, honor Cache-Control, TTL expiry (via
// manipulacion directa de expires, no sleep), eviction por capacidad.

import "src/cache"

// Helper: construye un response HTTP valido para feedearle al cache.
fn mk_response(status: int, headers_extra: String, body: String) -> String {
    let crlf: String = "\r\n"
    let status_line: String = "HTTP/1.1 " + int_to_string(status) + " OK" + crlf
    var resp: String = status_line
    resp = resp + "Content-Type: text/plain" + crlf
    if headers_extra.length() > 0 {
        resp = resp + headers_extra + crlf
    }
    // Content-Length cuenta BYTES (como un upstream real), no codepoints.
    resp = resp + "Content-Length: " + int_to_string(body.byte_length()) + crlf
    resp = resp + "Connection: close" + crlf
    resp = resp + crlf + body
    return resp
}

fn test_basic_hit_miss() {
    cache_init(10, 300)
    let resp: String = mk_response(200, "", "hello")

    // Miss inicial
    let m1: String = cache_lookup("example.com", "/")
    assert(m1.length() == 0)
    print("PASS: initial miss")

    // Store + lookup → hit
    let stored: int = cache_try_store("example.com", "/", resp)
    assert(stored == 1)
    let h1: String = cache_lookup("example.com", "/")
    assert(h1.length() > 0)
    assert(h1.indexOf("hello") >= 0)
    print("PASS: store + hit")
}

fn test_respect_no_store() {
    let resp: String = mk_response(200, "Cache-Control: no-store", "secret")
    let stored: int = cache_try_store("example.com", "/private", resp)
    assert(stored == 0)
    let miss: String = cache_lookup("example.com", "/private")
    assert(miss.length() == 0)
    print("PASS: Cache-Control no-store bypassa cache")
}

fn test_respect_no_cache() {
    let resp: String = mk_response(200, "Cache-Control: no-cache", "dynamic")
    let stored: int = cache_try_store("example.com", "/api", resp)
    assert(stored == 0)
    print("PASS: Cache-Control no-cache bypassa cache")
}

fn test_respect_private() {
    let resp: String = mk_response(200, "Cache-Control: private, max-age=300", "user-data")
    let stored: int = cache_try_store("example.com", "/account", resp)
    assert(stored == 0)
    print("PASS: Cache-Control private bypassa cache")
}

fn test_reject_non_200() {
    let resp404: String = mk_response(404, "", "not found")
    let stored: int = cache_try_store("example.com", "/missing", resp404)
    assert(stored == 0)
    print("PASS: status 404 no se cachea")
}

fn test_honor_max_age() {
    // max-age=0 debe no cachear (TTL <= 0 en cache_try_store retorna 0).
    let resp0: String = mk_response(200, "Cache-Control: max-age=0", "instant-stale")
    let s0: int = cache_try_store("example.com", "/zero-ttl", resp0)
    assert(s0 == 0)
    print("PASS: max-age=0 no se cachea")

    // max-age positivo si se cachea.
    let resp60: String = mk_response(200, "Cache-Control: max-age=60", "short-lived")
    let s60: int = cache_try_store("example.com", "/short", resp60)
    assert(s60 == 1)
    let hit: String = cache_lookup("example.com", "/short")
    assert(hit.indexOf("short-lived") >= 0)
    print("PASS: max-age=60 cachea correctamente")

    // Un max-age de 20 dígitos (no entra en 64 bits) vale 2^31 s: se cachea
    // en vez de abortar el proceso por un header del upstream.
    let big: String = mk_response(200, "Cache-Control: max-age=99999999999999999999", "huge-ttl")
    assert(cache_try_store("example.com", "/huge", big) == 1)
    assert(cache_lookup("example.com", "/huge").indexOf("huge-ttl") >= 0)
    print("PASS: max-age de 20 dígitos se cachea con 2^31 s")

    // Un status que no es número no se cachea y no aborta.
    let raro: String = "HTTP/1.1 abc OK\r\nCache-Control: max-age=60\r\nContent-Length: 2\r\n\r\nok"
    assert(cache_try_store("example.com", "/raro", raro) == 0)
    print("PASS: status no numérico no se cachea")
}

fn test_eviction_lru() {
    // Fresh cache con capacidad 2.
    // Nota: cache es singleton global. Asumimos que los tests previos
    // llenaron algunos slots, asi que probamos la logica en keys nuevos
    // suficientes para forzar eviction de los mas viejos.
    let r_a: String = mk_response(200, "", "A")
    let r_b: String = mk_response(200, "", "B")
    let r_c: String = mk_response(200, "", "C")

    cache_try_store("evict.test", "/a", r_a)
    cache_try_store("evict.test", "/b", r_b)

    // Tocar /a para moverlo al head.
    let touch_a: String = cache_lookup("evict.test", "/a")
    assert(touch_a.length() > 0)

    // Llenar a capacidad — el tamano efectivo depende del capacity (10).
    // Simplemente verificamos que /a y /b siguen accesibles tras un lookup intermedio.
    cache_try_store("evict.test", "/c", r_c)
    let h_a: String = cache_lookup("evict.test", "/a")
    let h_c: String = cache_lookup("evict.test", "/c")
    assert(h_a.length() > 0)
    assert(h_c.length() > 0)
    print("PASS: LRU tracking mantiene entries accessed recientemente")
}

fn test_cache_hit_body_integrity() {
    // Regresion del "off-by-8" que mantuvo el cache desactivado en
    // produccion: con contenido multi-byte (acentos, →, ©, como las
    // landings reales) cache_mark_hit truncaba el final del response en
    // exactamente byte_length - length codepoints, dejando Content-Length
    // intacto → el cliente esperaba bytes que nunca llegaban (timeout).
    let body: String = "café → naïve © ñandú — fin"
    let resp: String = mk_response(200, "Cache-Control: max-age=60", body)

    let stored: int = cache_try_store("utf8.test", "/multibyte", resp)
    assert(stored == 1)
    let cached: String = cache_lookup("utf8.test", "/multibyte")
    assert(cached.byte_length() == resp.byte_length())

    let marked: String = cache_mark_hit(cached)
    // El header inyectado "\r\nX-Nyx-Cache: HIT" mide 18 bytes exactos;
    // ni un byte del body puede perderse.
    assert(marked.byte_length() == resp.byte_length() + 18)
    // El body completo debe seguir presente, intacto, al final.
    assert(marked.indexOf(body) >= 0)
    print("PASS: cache hit preserva integridad de bytes con body multi-byte")
}

fn test_singleflight_claim_release() {
    // Claim primero — deberia ganar (retorna 1).
    let a: int = singleflight_claim("sf.test", "/first")
    assert(a == 1)
    // Segundo claim sobre misma key — debe perder (retorna 0, alguien ya fetchea).
    let b: int = singleflight_claim("sf.test", "/first")
    assert(b == 0)
    // Release libera el slot.
    singleflight_release("sf.test", "/first")
    // Ahora otro claim gana.
    let c: int = singleflight_claim("sf.test", "/first")
    assert(c == 1)
    singleflight_release("sf.test", "/first")
    print("PASS: singleflight claim/release round-trip")
}

fn test_singleflight_wait_timeout() {
    // Claim un slot y NO liberes — un wait con timeout corto debe
    // expirar y devolver "".
    singleflight_claim("sf.test", "/stuck")
    let t0: int = time_ms()
    let wait_result: String = singleflight_wait("sf.test", "/stuck", 50)
    let elapsed: int = time_ms() - t0
    assert(wait_result.length() == 0)
    assert(elapsed >= 50)
    // Cleanup para no afectar otros tests.
    singleflight_release("sf.test", "/stuck")
    print("PASS: singleflight wait timeout respetado (elapsed=" + int_to_string(elapsed) + "ms)")
}

fn sf_condvar_releaser() {
    // Duerme un poco menos que el timeout del wait de abajo, despues
    // libera el slot — el wait debe despertar via el broadcast de
    // singleflight_release, no tras agotar los 3000ms.
    sleep(30)
    singleflight_release("sf.test", "/concurrent")
    return 0
}

fn test_singleflight_condvar_wakeup() {
    // Claim en el thread principal (simula el fetcher en curso); un
    // segundo thread libera el slot 30ms despues. El wait (condvar,
    // no busy-poll de 10ms) debe retornar bien antes de los 100ms —
    // si volviera al busy-poll viejo seguiria pasando el mismo test,
    // pero mide directamente la wakeup latency que motivo el cambio.
    singleflight_claim("sf.test", "/concurrent")
    let tid: int = thread_spawn(sf_condvar_releaser)
    let t0: int = time_ms()
    singleflight_wait("sf.test", "/concurrent", 3000)
    let elapsed: int = time_ms() - t0
    thread_join(tid)
    assert(elapsed < 100)
    print("PASS: singleflight wait despierta via condvar broadcast (elapsed=" + int_to_string(elapsed) + "ms)")
}

fn test_singleflight_counters() {
    let snap: Array = singleflight_snapshot()
    let waits: int = snap[0]
    let timeouts: int = snap[1]
    // Al menos el timeout anterior debe haberse registrado.
    assert(waits >= 1)
    assert(timeouts >= 1)
    print("PASS: singleflight counters (waits=" + int_to_string(waits) + " timeouts=" + int_to_string(timeouts) + ")")
}

fn test_snapshot_counters() {
    // Despues de los tests anteriores, hits y misses deben ser > 0.
    let snap: Array = cache_snapshot()
    let size: int = snap[0]
    let hits: int = snap[1]
    let misses: int = snap[2]
    assert(size > 0)
    assert(hits > 0)
    assert(misses > 0)
    print("PASS: snapshot counters (size=" + int_to_string(size) + " hits=" + int_to_string(hits) + " misses=" + int_to_string(misses) + ")")
}

// ─────────────────────────────────────────────
// Conducta de la reescritura (bypass, Set-Cookie, Cache-Control, Vary, 304)
// ─────────────────────────────────────────────

// Helper: varias cabeceras extra para mk_response.
fn hdrs(a: String, b: String) -> String {
    return a + "\r\n" + b
}

fn test_request_bypass() {
    let c1: Array = ["Host", "x.test", "Cookie", "sid=1"]
    assert(cache_request_bypass(c1) == 1)
    let c2: Array = ["cookie", "sid=1"]
    assert(cache_request_bypass(c2) == 1)
    let c3: Array = ["Accept", "*/*", "AUTHORIZATION", "Bearer x"]
    assert(cache_request_bypass(c3) == 1)
    let c4: Array = ["Authorization", "Basic abc"]
    assert(cache_request_bypass(c4) == 1)
    // Valor vacío: igual cuenta.
    let c5: Array = ["Cookie", ""]
    assert(cache_request_bypass(c5) == 1)
    let c6: Array = ["authorization", ""]
    assert(cache_request_bypass(c6) == 1)
    // Sin ellas: pasa.
    let n1: Array = ["Accept", "text/html", "User-Agent", "curl/8"]
    assert(cache_request_bypass(n1) == 0)
    let n2: Array = []
    assert(cache_request_bypass(n2) == 0)
    // Un VALOR "cookie" no es la cabecera Cookie.
    let n3: Array = ["X-Note", "cookie", "Accept", "authorization"]
    assert(cache_request_bypass(n3) == 0)
    print("PASS: cache_request_bypass detecta Cookie/Authorization en cualquier capitalizacion")
}

fn test_set_cookie_not_stored() {
    let r1: String = mk_response(200, "Set-Cookie: sid=abc; Path=/", "user-body")
    assert(cache_try_store("sc.test", "/a", r1) == 0)
    assert(cache_lookup("sc.test", "/a").byte_length() == 0)
    let r2: String = mk_response(200, "set-cookie: sid=abc", "user-body")
    assert(cache_try_store("sc.test", "/b", r2) == 0)
    assert(cache_lookup("sc.test", "/b").byte_length() == 0)
    // Control: sin Set-Cookie se guarda.
    let ok: String = mk_response(200, "", "anon-body")
    assert(cache_try_store("sc.test", "/c", ok) == 1)
    assert(cache_lookup("sc.test", "/c").indexOf("anon-body") >= 0)
    print("PASS: Set-Cookie en la respuesta no se guarda")
}

fn test_cc_only_from_header() {
    // Sin cabecera Cache-Control; el CUERPO dice no-store: se guarda igual.
    let r1: String = mk_response(200, "", "texto Cache-Control: no-store en el cuerpo")
    assert(cache_try_store("cc.test", "/body-nostore", r1) == 1)
    let h1: String = cache_lookup("cc.test", "/body-nostore")
    assert(h1.indexOf("en el cuerpo") >= 0)
    // Cuerpo con max-age=0: tampoco impide guardar (ni fija el TTL).
    let r2: String = mk_response(200, "", "Cache-Control: max-age=0")
    assert(cache_try_store("cc.test", "/body-maxage0", r2) == 1)
    assert(cache_lookup("cc.test", "/body-maxage0").indexOf("max-age=0") >= 0)
    // Cuerpo con private / no-cache tampoco.
    let r3: String = mk_response(200, "", "Cache-Control: private, no-cache")
    assert(cache_try_store("cc.test", "/body-private", r3) == 1)
    print("PASS: Cache-Control se lee solo de la cabecera, no del cuerpo")
}

fn test_cc_case_insensitive() {
    let r1: String = mk_response(200, "CACHE-CONTROL: No-Store", "x")
    assert(cache_try_store("cci.test", "/a", r1) == 0)
    let r2: String = mk_response(200, "cache-control: NO-CACHE", "x")
    assert(cache_try_store("cci.test", "/b", r2) == 0)
    let r3: String = mk_response(200, "Cache-Control: PRIVATE, max-age=60", "x")
    assert(cache_try_store("cci.test", "/c", r3) == 0)
    // MAX-AGE en mayúsculas igual fija el TTL (60 > 0 -> se guarda).
    let r4: String = mk_response(200, "CACHE-CONTROL: MAX-AGE=60", "mayus-ok")
    assert(cache_try_store("cci.test", "/d", r4) == 1)
    assert(cache_lookup("cci.test", "/d").indexOf("mayus-ok") >= 0)
    let r5: String = mk_response(200, "Cache-Control: MAX-AGE=0", "x")
    assert(cache_try_store("cci.test", "/e", r5) == 0)
    print("PASS: Cache-Control sin distinguir mayusculas")
}

fn test_cc_whole_directive() {
    // "private" solo como subcadena de una extensión: SÍ se guarda.
    let r1: String = mk_response(200, "Cache-Control: max-age=60, x-private-ext=1", "ext-private")
    assert(cache_try_store("ccd.test", "/a", r1) == 1)
    assert(cache_lookup("ccd.test", "/a").indexOf("ext-private") >= 0)
    let r2: String = mk_response(200, "Cache-Control: max-age=60, my-no-cache-hint", "hint-cache")
    assert(cache_try_store("ccd.test", "/b", r2) == 1)
    assert(cache_lookup("ccd.test", "/b").indexOf("hint-cache") >= 0)
    let r3: String = mk_response(200, "Cache-Control: max-age=60, x-no-store-thing", "hint-store")
    assert(cache_try_store("ccd.test", "/c", r3) == 1)
    assert(cache_lookup("ccd.test", "/c").indexOf("hint-store") >= 0)
    // Control: la directiva entera, con espacios alrededor, sí bloquea.
    let r4: String = mk_response(200, "Cache-Control: max-age=60 ,  private ", "x")
    assert(cache_try_store("ccd.test", "/d", r4) == 0)
    // Un nombre de directiva que SOLO se parece a max-age no fija el TTL:
    // "xmax-age=0" no es max-age, así que rige el TTL por defecto y se guarda.
    let r5: String = mk_response(200, "Cache-Control: xmax-age=0", "no-es-maxage")
    assert(cache_try_store("ccd.test", "/e", r5) == 1)
    print("PASS: Cache-Control compara por directiva entera, no por subcadena")
}

fn test_smaxage_precedence() {
    let r1: String = mk_response(200, "Cache-Control: max-age=0, s-maxage=60", "smax-gana")
    assert(cache_try_store("smax.test", "/a", r1) == 1)
    assert(cache_lookup("smax.test", "/a").indexOf("smax-gana") >= 0)
    let r2: String = mk_response(200, "Cache-Control: max-age=60, s-maxage=0", "x")
    assert(cache_try_store("smax.test", "/b", r2) == 0)
    assert(cache_lookup("smax.test", "/b").byte_length() == 0)
    // Orden invertido de las directivas: lo mismo.
    let r3: String = mk_response(200, "Cache-Control: s-maxage=0, max-age=60", "x")
    assert(cache_try_store("smax.test", "/c", r3) == 0)
    print("PASS: s-maxage manda sobre max-age")
}

fn test_vary_ae_miss_and_hit() {
    // El caso del reporte: un cliente sin Accept-Encoding recibía gzip.
    let gz: String = mk_response(200, hdrs("Vary: Accept-Encoding", "Content-Encoding: gzip"), "CUERPO-GZIP")
    assert(cache_try_store_v("vary.test", "/a", "gzip", gz) == 1)
    let miss: String = cache_lookup_v("vary.test", "/a", "")
    assert(miss.byte_length() == 0)
    let hit: String = cache_lookup_v("vary.test", "/a", "gzip")
    assert(hit.byte_length() > 0)
    assert(hit.indexOf("CUERPO-GZIP") >= 0)
    assert(hit.indexOf("Content-Encoding: gzip") >= 0)
    // Otro ae (br) tampoco recibe lo gzip.
    assert(cache_lookup_v("vary.test", "/a", "br").byte_length() == 0)
    print("PASS: Vary Accept-Encoding: ae distinto es miss, ae igual es hit con su cuerpo")
}

fn test_vary_two_variants_coexist() {
    let ident: String = mk_response(200, "Vary: Accept-Encoding", "CUERPO-IDENTIDAD")
    let gz: String = mk_response(200, hdrs("Vary: Accept-Encoding", "Content-Encoding: gzip"), "CUERPO-GZ")
    assert(cache_try_store_v("two.test", "/a", "", ident) == 1)
    assert(cache_try_store_v("two.test", "/a", "gzip", gz) == 1)
    let h0: String = cache_lookup_v("two.test", "/a", "")
    let h1: String = cache_lookup_v("two.test", "/a", "gzip")
    assert(h0.indexOf("CUERPO-IDENTIDAD") >= 0)
    assert(h0.indexOf("CUERPO-GZ") < 0)
    assert(h1.indexOf("CUERPO-GZ") >= 0)
    assert(h1.indexOf("CUERPO-IDENTIDAD") < 0)
    print("PASS: variantes identidad y gzip del mismo host/path conviven")
}

fn test_vary_other_not_stored() {
    let r1: String = mk_response(200, "Vary: Cookie", "x")
    assert(cache_try_store("vo.test", "/a", r1) == 0)
    let r2: String = mk_response(200, "Vary: Accept-Encoding, Cookie", "x")
    assert(cache_try_store_v("vo.test", "/b", "gzip", r2) == 0)
    let r3: String = mk_response(200, "Vary: *", "x")
    assert(cache_try_store("vo.test", "/c", r3) == 0)
    let r4: String = mk_response(200, "Vary: Accept-Language", "x")
    assert(cache_try_store("vo.test", "/d", r4) == 0)
    assert(cache_lookup("vo.test", "/a").byte_length() == 0)
    assert(cache_lookup_v("vo.test", "/b", "gzip").byte_length() == 0)
    // Minúsculas y espacios: sí.
    let ok: String = mk_response(200, "vary: accept-encoding", "vary-min")
    assert(cache_try_store("vo.test", "/e", ok) == 1)
    assert(cache_lookup("vo.test", "/e").indexOf("vary-min") >= 0)
    print("PASS: Vary distinto de Accept-Encoding no se guarda (vary minusculas si)")
}

fn test_content_encoding_without_vary() {
    let gz: String = mk_response(200, "Content-Encoding: gzip", "SIN-VARY-GZ")
    assert(cache_try_store_v("cev.test", "/a", "gzip", gz) == 1)
    assert(cache_lookup_v("cev.test", "/a", "").byte_length() == 0)
    let hit: String = cache_lookup_v("cev.test", "/a", "gzip")
    assert(hit.indexOf("SIN-VARY-GZ") >= 0)
    // Content-Encoding en minúsculas / valor en mayúsculas.
    let gz2: String = mk_response(200, "content-encoding: GZIP", "MAYUS-GZ")
    assert(cache_try_store_v("cev.test", "/b", "gzip", gz2) == 1)
    assert(cache_lookup_v("cev.test", "/b", "").byte_length() == 0)
    assert(cache_lookup_v("cev.test", "/b", "gzip").indexOf("MAYUS-GZ") >= 0)
    print("PASS: Content-Encoding sin Vary se guarda por variante")
}

fn test_content_encoding_not_accepted() {
    let gz: String = mk_response(200, "Content-Encoding: gzip", "x")
    assert(cache_try_store_v("cna.test", "/a", "", gz) == 0)
    assert(cache_try_store_v("cna.test", "/b", "br", gz) == 0)
    assert(cache_lookup_v("cna.test", "/a", "").byte_length() == 0)
    assert(cache_lookup_v("cna.test", "/b", "br").byte_length() == 0)
    // Código desconocido: no se guarda aunque el pedido acepte "*".
    let cp: String = mk_response(200, "Content-Encoding: compress", "x")
    assert(cache_try_store_v("cna.test", "/c", "gzip", cp) == 0)
    assert(cache_try_store_v("cna.test", "/d", "*", cp) == 0)
    // "*" sí acepta un código conocido.
    let star: String = mk_response(200, "Content-Encoding: br", "estrella-br")
    assert(cache_try_store_v("cna.test", "/e", "*", star) == 1)
    assert(cache_lookup_v("cna.test", "/e", "*").indexOf("estrella-br") >= 0)
    // identity explícito se trata como sin codificar (clave base).
    let idn: String = mk_response(200, "Content-Encoding: identity", "es-identity")
    assert(cache_try_store_v("cna.test", "/f", "gzip", idn) == 1)
    assert(cache_lookup_v("cna.test", "/f", "").indexOf("es-identity") >= 0)
    print("PASS: Content-Encoding no aceptado por el pedido o desconocido no se guarda")
}

fn test_base_key_serves_any_ae() {
    let r: String = mk_response(200, "", "CUERPO-BASE")
    assert(cache_try_store_v("base.test", "/a", "gzip", r) == 1)
    assert(cache_lookup_v("base.test", "/a", "").indexOf("CUERPO-BASE") >= 0)
    assert(cache_lookup_v("base.test", "/a", "br").indexOf("CUERPO-BASE") >= 0)
    assert(cache_lookup_v("base.test", "/a", "gzip").indexOf("CUERPO-BASE") >= 0)
    print("PASS: respuesta sin Vary ni Content-Encoding se sirve a cualquier ae")
}

fn test_variant_removes_base() {
    let base: String = mk_response(200, "", "BASE-VIEJA")
    assert(cache_try_store_v("rb.test", "/a", "", base) == 1)
    assert(cache_lookup_v("rb.test", "/a", "").indexOf("BASE-VIEJA") >= 0)
    let gz: String = mk_response(200, hdrs("Vary: Accept-Encoding", "Content-Encoding: gzip"), "VARIANTE-GZ")
    assert(cache_try_store_v("rb.test", "/a", "gzip", gz) == 1)
    // La base no puede taparla ni responderle a ae "".
    assert(cache_lookup_v("rb.test", "/a", "").byte_length() == 0)
    let h: String = cache_lookup_v("rb.test", "/a", "gzip")
    assert(h.indexOf("VARIANTE-GZ") >= 0)
    assert(h.indexOf("BASE-VIEJA") < 0)
    print("PASS: guardar una variante borra la entrada base previa")
}

fn test_accept_encoding_key() {
    assert(cache_accept_encoding_key("gzip, deflate, br, zstd") == "br,deflate,gzip,zstd")
    assert(cache_accept_encoding_key("GZIP") == "gzip")
    assert(cache_accept_encoding_key("") == "")
    assert(cache_accept_encoding_key("gzip;q=0, br") == "br")
    assert(cache_accept_encoding_key("gzip;q=0.5") == "gzip")
    assert(cache_accept_encoding_key("x-foo, gzip") == "gzip")
    assert(cache_accept_encoding_key("*") == "*")
    assert(cache_accept_encoding_key("br, gzip") == cache_accept_encoding_key("gzip, br"))
    assert(cache_accept_encoding_key("br, gzip") == "br,gzip")
    // Extras: q=0.0 excluye; espacios alrededor; repetidos; solo desconocidos.
    assert(cache_accept_encoding_key("gzip;q=0.0, br") == "br")
    assert(cache_accept_encoding_key("  gzip ;  q=0 , deflate") == "deflate")
    assert(cache_accept_encoding_key("gzip, gzip") == "gzip")
    assert(cache_accept_encoding_key("x-foo, compress") == "")
    assert(cache_accept_encoding_key("gzip, *") == "gzip,*")
    print("PASS: cache_accept_encoding_key normaliza")
}

fn mk_cached_304() -> String {
    let h: String = hdrs("ETag: \"abc\"", "Cache-Control: max-age=60")
    return mk_response(200, h, "BODYXYZ")
}

fn test_not_modified_inm() {
    let cached: String = mk_cached_304()
    let rq: Array = ["If-None-Match", "\"abc\""]
    let r: String = cache_not_modified(cached, rq)
    assert(r.startsWith("HTTP/1.1 304"))
    assert(r.indexOf("BODYXYZ") < 0)
    assert(r.indexOf("Content-Length") < 0)
    assert(r.indexOf("ETag: \"abc\"") >= 0)
    assert(r.indexOf("Cache-Control: max-age=60") >= 0)
    assert(r.indexOf("X-Nyx-Cache: HIT") >= 0)
    assert(r.endsWith("\r\n\r\n"))
    // No arrastra cabeceras que un 304 no repite.
    assert(r.indexOf("Content-Type") < 0)
    print("PASS: If-None-Match igual al ETag guardado -> 304 sin cuerpo")
}

fn test_not_modified_weak_and_list() {
    let strong: String = mk_cached_304()
    let weak_cached: String = mk_response(200, "ETag: W/\"abc\"", "BODYXYZ")
    // Guardado débil, pedido fuerte.
    let rq1: Array = ["If-None-Match", "\"abc\""]
    assert(cache_not_modified(weak_cached, rq1).startsWith("HTTP/1.1 304"))
    // Guardado fuerte, pedido débil.
    let rq2: Array = ["If-None-Match", "W/\"abc\""]
    assert(cache_not_modified(strong, rq2).startsWith("HTTP/1.1 304"))
    // Los dos débiles.
    assert(cache_not_modified(weak_cached, rq2).startsWith("HTTP/1.1 304"))
    // Lista.
    let rq3: Array = ["If-None-Match", "\"x\", W/\"abc\", \"y\""]
    assert(cache_not_modified(strong, rq3).startsWith("HTTP/1.1 304"))
    // Comodín.
    let rq4: Array = ["If-None-Match", "*"]
    assert(cache_not_modified(strong, rq4).startsWith("HTTP/1.1 304"))
    // Distinto.
    let rq5: Array = ["If-None-Match", "\"zzz\""]
    assert(cache_not_modified(strong, rq5) == "")
    // Prefijo / subcadena del guardado.
    let rq6: Array = ["If-None-Match", "\"ab\""]
    assert(cache_not_modified(strong, rq6) == "")
    let rq7: Array = ["If-None-Match", "\"abcd\""]
    assert(cache_not_modified(strong, rq7) == "")
    let rq8: Array = ["If-None-Match", "\"bc\", \"b\""]
    assert(cache_not_modified(strong, rq8) == "")
    // Sin ETag guardado: un ETag pedido no coincide.
    let noetag: String = mk_response(200, "", "BODYXYZ")
    assert(cache_not_modified(noetag, rq1) == "")
    print("PASS: If-None-Match debil, lista, comodin y no-coincidencias")
}

fn test_not_modified_lowercase_header() {
    let cached: String = mk_cached_304()
    let rq: Array = ["if-none-match", "\"abc\""]
    assert(cache_not_modified(cached, rq).startsWith("HTTP/1.1 304"))
    let rq2: Array = ["IF-NONE-MATCH", "\"abc\""]
    assert(cache_not_modified(cached, rq2).startsWith("HTTP/1.1 304"))
    print("PASS: If-None-Match con el nombre en minusculas/mayusculas")
}

fn test_not_modified_ims() {
    let lm: String = "Sun, 06 Nov 1994 08:49:37 GMT"
    let cached: String = mk_response(200, "Last-Modified: " + lm, "BODYLM")
    let eq: Array = ["If-Modified-Since", lm]
    let r: String = cache_not_modified(cached, eq)
    assert(r.startsWith("HTTP/1.1 304"))
    assert(r.indexOf("BODYLM") < 0)
    assert(r.indexOf("Last-Modified: " + lm) >= 0)
    // Posterior: 304.
    let later: Array = ["If-Modified-Since", "Mon, 07 Nov 1994 08:49:37 GMT"]
    assert(cache_not_modified(cached, later).startsWith("HTTP/1.1 304"))
    let later_year: Array = ["if-modified-since", "Sun, 06 Nov 1995 08:49:37 GMT"]
    assert(cache_not_modified(cached, later_year).startsWith("HTTP/1.1 304"))
    // Anterior: hay que mandar la respuesta entera.
    let earlier: Array = ["If-Modified-Since", "Sat, 05 Nov 1994 08:49:37 GMT"]
    assert(cache_not_modified(cached, earlier) == "")
    let earlier_sec: Array = ["If-Modified-Since", "Sun, 06 Nov 1994 08:49:36 GMT"]
    assert(cache_not_modified(cached, earlier_sec) == "")
    // Sin Last-Modified guardado.
    let nolm: String = mk_response(200, "", "BODYLM")
    assert(cache_not_modified(nolm, eq) == "")
    print("PASS: If-Modified-Since igual/posterior -> 304, anterior o sin Last-Modified -> vacio")
}

fn test_not_modified_inm_wins_over_ims() {
    let lm: String = "Sun, 06 Nov 1994 08:49:37 GMT"
    let h: String = hdrs("ETag: \"abc\"", "Last-Modified: " + lm)
    let cached: String = mk_response(200, h, "BODYBOTH")
    // INM no coincide, IMS sí: NO hay 304.
    let rq: Array = ["If-None-Match", "\"otro\"", "If-Modified-Since", lm]
    assert(cache_not_modified(cached, rq) == "")
    // Orden inverso de cabeceras: igual.
    let rq2: Array = ["If-Modified-Since", lm, "If-None-Match", "\"otro\""]
    assert(cache_not_modified(cached, rq2) == "")
    // INM coincide, IMS no: 304 (manda INM).
    let rq3: Array = ["If-None-Match", "\"abc\"", "If-Modified-Since", "Sat, 05 Nov 1994 08:49:37 GMT"]
    assert(cache_not_modified(cached, rq3).startsWith("HTTP/1.1 304"))
    print("PASS: si viene If-None-Match, If-Modified-Since se ignora")
}

fn test_not_modified_unconditional() {
    let cached: String = mk_cached_304()
    let rq: Array = ["Accept", "*/*", "Host", "x.test"]
    assert(cache_not_modified(cached, rq) == "")
    let rq0: Array = []
    assert(cache_not_modified(cached, rq0) == "")
    // Respuesta sin separador de cabecera: nada que hacer.
    let rqi: Array = ["If-None-Match", "*"]
    assert(cache_not_modified("basura", rqi) == "")
    print("PASS: pedido sin condicionales -> vacio")
}

fn test_singleflight_per_variant() {
    assert(singleflight_claim_v("sfv.test", "/p", "gzip") == 1)
    // Otra variante es otra clave: también gana.
    assert(singleflight_claim_v("sfv.test", "/p", "") == 1)
    // La misma variante pierde.
    assert(singleflight_claim_v("sfv.test", "/p", "gzip") == 0)
    assert(singleflight_claim_v("sfv.test", "/p", "") == 0)
    singleflight_release_v("sfv.test", "/p", "gzip")
    // Liberar una no libera la otra.
    assert(singleflight_claim_v("sfv.test", "/p", "") == 0)
    assert(singleflight_claim_v("sfv.test", "/p", "gzip") == 1)
    singleflight_release_v("sfv.test", "/p", "gzip")
    singleflight_release_v("sfv.test", "/p", "")
    print("PASS: single-flight reclama por variante de Accept-Encoding")
}

// Último: vacía la caché y rompe la premisa (size > 0) de test_snapshot_counters.
fn test_cache_clear() {
    let r: String = mk_response(200, "", "A-BORRAR")
    assert(cache_try_store("clr.test", "/a", r) == 1)
    assert(cache_lookup("clr.test", "/a").indexOf("A-BORRAR") >= 0)
    assert(cache_snapshot()[0] > 0)
    let ev0: int = cache_snapshot()[3]
    cache_clear()
    assert(cache_lookup("clr.test", "/a").byte_length() == 0)
    assert(cache_lookup("example.com", "/").byte_length() == 0)
    assert(cache_snapshot()[0] == 0)
    // No cuenta como evictions.
    assert(cache_snapshot()[3] == ev0)
    // Sigue usable tras el clear.
    assert(cache_try_store("clr.test", "/b", r) == 1)
    assert(cache_lookup("clr.test", "/b").indexOf("A-BORRAR") >= 0)
    cache_clear()
    assert(cache_snapshot()[0] == 0)
    print("PASS: cache_clear vacia la cache")
}

