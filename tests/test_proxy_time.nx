// test_proxy_time.nx — Regresión del 2026-09-10: el proxy dividía `time_epoch()`
// entre 1.000.000 en DOS sitios, con el comentario «// seconds» al lado.
// `time_epoch()` ya devuelve segundos, así que la división convertía el reloj en
// un contador que avanza una vez cada 11,6 días.
//
//   · src/ratelimit.nx — la ventana del rate limiter quedaba congelada: todas
//     las peticiones de casi dos semanas caían en el mismo cubo, así que una IP
//     que llegaba al límite quedaba bloqueada hasta el siguiente múltiplo de
//     1.000.000 de segundos.
//   · src/logger.nx — cada línea del access log escribía «1789» en vez de la
//     marca de tiempo.
//
// Ninguna de las dos suites que había cubría estos módulos; por eso el bug
// sobrevivió. Este test cierra los dos.

import "std/http"
import "std/proxy"
import "src/config"
import "src/router"
import "src/health"
import "src/logger"
import "src/ratelimit"
import "src/metrics"

// Extrae el valor de una metrica Prometheus sin labels: "nombre 42\n" -> 42.
// La marca lleva el "\n" adelante a proposito: sin el, indexOf pega primero en
// la linea "# HELP <nombre> Seconds since..." y se intenta parsear la glosa.
fn valor_metrica(salida: String, nombre: String) -> int {
    let marca: String = "\n" + nombre + " "
    let pos: int = salida.indexOf(marca)
    if pos < 0 { return -1 }
    let desde: int = pos + marca.length()
    var fin: int = desde
    while fin < salida.length() {
        let c: String = salida.substring(fin, fin + 1)
        if c == "\n" { break }
        fin = fin + 1
    }
    return string_to_int(salida.substring(desde, fin))
}

fn primer_campo(linea: String) -> String {
    let esp: int = linea.indexOf(" ")
    if esp < 0 { return linea }
    return linea.substring(0, esp)
}

var g_srv_lat: Array = [0]

// Upstream que tarda ~60 ms en responder. El número importa: por debajo de
// 1000 ms, el bug que este caso caza registraba CERO.
fn up_lento() -> int {
    let c: int = tcp_accept(g_srv_lat[0])
    var fin: int = 0
    while fin == 0 {
        let line: String = tcp_read_line(c)
        if line.length() == 0 { fin = 1 }
    }
    sleep(60)
    tcp_write(c, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")
    tcp_close(c)
    return 0
}

// Extrae una métrica CON label de host: `nombre{host="h"} 42` -> 42.
fn valor_metrica_host(salida: String, nombre: String, host: String) -> int {
    let marca: String = "\n" + nombre + "{host=\"" + host + "\"} "
    let pos: int = salida.indexOf(marca)
    if pos < 0 { return -1 }
    let desde: int = pos + marca.length()
    var fin: int = desde
    while fin < salida.length() {
        let c: String = salida.substring(fin, fin + 1)
        if c == "\n" { break }
        fin = fin + 1
    }
    return string_to_int(salida.substring(desde, fin))
}

// ── Tercer bug de la misma familia: la LATENCIA se medía en segundos ─────────
// `access_log` y `metrics_record_request` reciben `latency_us` y dividen entre
// 1000, pero `proxy_dispatch` medía con `time_epoch()`, que da SEGUNDOS. Una
// petición de 300 ms entraba como 0: el access log escribía «0ms» en todas sus
// líneas y el histograma metía TODO en el primer bucket. Sobrevivió a los dos
// arreglos anteriores de esta familia porque ninguna suite miraba el VALOR de la
// latencia, solo su formato — por eso este caso mide un número, no un texto.
fn test_latencia_real_no_se_registra_como_cero() {
    let puerto: int = 19371
    let srv: int = tcp_listen("127.0.0.1", puerto)
    g_srv_lat[0] = srv
    let tid: int = thread_spawn(up_lento)

    let ruta: String = "/tmp/nyx_proxy_test_latencia.toml"
    var cfg: String = "[server]\nlisten = 18080\n\n[upstream.0]\n"
    cfg = cfg + "name = \"lento\"\n"
    cfg = cfg + "host = \"127.0.0.1\"\n"
    cfg = cfg + "port = " + int_to_string(puerto) + "\n"
    write_file(ruta, cfg)
    load_config(ruta)
    metrics_init()
    pool_init()

    let headers: Array = ["Host", "lat.test"]
    let req: Array = ["request", "GET", "/", headers, ""]
    let resp: String = proxy_dispatch(req)
    thread_join(tid)
    tcp_close(srv)
    remove_file(ruta)

    assert(resp.indexOf("200") >= 0, "la petición llega al upstream y vuelve")

    let out: String = metrics_render()
    let suma: int = valor_metrica_host(out, "nyx_proxy_upstream_latency_ms_sum", "lat.test")
    let cuenta: int = valor_metrica_host(out, "nyx_proxy_upstream_latency_ms_count", "lat.test")
    print("  latencia registrada: " + int_to_string(suma) + " ms (el upstream tardó ~60)")

    assert(cuenta == 1, "la petición se contabilizó")
    // El corazón del caso: con el bug, `suma` era 0 y la muestra caía en le="1".
    assert(suma >= 40, "una petición de ~60 ms NO se registra como 0 ms")
    assert(suma < 5000, "y tampoco se registra inflada (microsegundos sin dividir)")
    assert(out.indexOf("nyx_proxy_upstream_latency_ms_bucket{host=\"lat.test\",le=\"1\"} 0") >= 0,
           "la muestra no cae en el primer bucket del histograma")
    print("PASS router: la latencia se mide en microsegundos, no en segundos")
}

fn main() -> int {
    // Se inicializa acá para que el sleep de 1,1 s del rate limiter valga
    // también como uptime medible más abajo, sin dormir dos veces.
    metrics_init()

    // ── Rate limiter ──────────────────────────────────────────────────────
    g_rate_limit = 2

    // Ráfaga dentro de una misma ventana de un segundo: la tercera petición
    // debe dar 429. Se reintenta porque la ráfaga puede caer justo sobre el
    // borde del segundo y resetear el cubo a mitad de camino; con la ráfaga
    // durando microsegundos, fallar cinco veces seguidas no pasa.
    var rechazo: String = ""
    var intento: int = 0
    while intento < 5 && rechazo.length() == 0 {
        let ip: String = "198.51.100." + int_to_string(intento)
        let a: String = proxy_check_rate(ip, "test")
        let b: String = proxy_check_rate(ip, "test")
        let c: String = proxy_check_rate(ip, "test")
        if a.length() == 0 && b.length() == 0 && c.length() > 0 {
            rechazo = c
        }
        intento = intento + 1
    }
    assert(rechazo.length() > 0)
    assert(rechazo.indexOf("429 Too Many Requests") >= 0)
    print("PASS ratelimit: la petición que pasa el límite recibe 429")

    // EL caso de regresión: pasado un segundo, la ventana avanza y la misma IP
    // vuelve a pasar. Con `time_epoch() / 1000000` el valor de `now` era el
    // mismo un segundo después —y once días después—, así que esta llamada
    // seguía devolviendo 429.
    let ip_bloqueada: String = "198.51.100." + int_to_string(intento - 1)
    sleep(1100)
    let despues: String = proxy_check_rate(ip_bloqueada, "test")
    assert(despues.length() == 0)
    print("PASS ratelimit: la ventana avanza con el reloj (un segundo la resetea)")

    // ── /metrics: uptime ──────────────────────────────────────────────────
    // Tercer sitio del mismo error: `metrics_init` guardaba
    // `time_epoch() / 1000` en una variable llamada `_ms` y el render volvía a
    // dividir entre 1000, así que `nyx_proxy_uptime_seconds` marcaba 0 hasta
    // que el proxy llevaba 11,6 días arriba. Con el sleep de arriba ya pasó
    // más de un segundo desde `metrics_init()`.
    let uptime: int = valor_metrica(metrics_render(), "nyx_proxy_uptime_seconds")
    assert(uptime >= 1)
    print("PASS metrics: nyx_proxy_uptime_seconds avanza (" + int_to_string(uptime) + "s)")

    // ── Access log ────────────────────────────────────────────────────────
    let ruta: String = "/tmp/nyx_proxy_test_access.log"
    if file_exists(ruta) { remove_file(ruta) }
    g_access_log_path = ruta
    access_log("GET", "/salud", 200, 4321)

    assert(file_exists(ruta))
    let contenido: String = read_file(ruta)
    let ts_txt: String = primer_campo(contenido)
    let ts: int = string_to_int(ts_txt)

    // Cota inferior fija: 2023-11-14. Cualquier epoch real la supera; el 1789
    // que escribía el bug, no. Se evita comparar contra `time_epoch()` en vivo
    // para que el test no se apoye en la función que está bajo prueba.
    assert(ts > 1700000000)
    print("PASS logger: el access log escribe un epoch real (" + ts_txt + "), no 1789")

    assert(contenido.indexOf("GET /salud 200 4ms") >= 0)
    print("PASS logger: método, ruta, estado y latencia en milisegundos")

    remove_file(ruta)

    test_latencia_real_no_se_registra_como_cero()

    print("test_proxy_time: OK")
    return 0
}
