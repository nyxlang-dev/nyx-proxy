// Backend de la prueba e2e de HTTP/2: el servidor del reporte de nyxerp (un
// canal SSE por pantalla) más rutas para medir lo que importa.
// Uso: ./backend <puerto>
import "std/web"
import "std/serve"
import "std/http"

fn avisos(req: Request) -> Response { return sse_open(req, "sala") }
// La caché del gateway de prueba está encendida (ver run.sh): las rutas que los
// chequeos viejos piden varias veces y esperan FRESCAS mandan no-store.
fn sin_cache(r: Response) -> Response {
    r.headers_flat.push("Cache-Control")
    r.headers_flat.push("no-store")
    return r
}
fn hola(_req: Request) -> Response { return sin_cache(response_new(200, "hola")) }
fn lento(_req: Request) -> Response {
    sleep(1500)
    return sin_cache(response_new(200, "lento"))
}
fn eco(req: Request) -> Response { return response_new(200, req.body) }
fn grande(_req: Request) -> Response {
    return sin_cache(response_new(200, "0123456789abcdef".repeat(64 * 293)))
}

// Estático de ~50 KB con ETag y SIN Cache-Control: el gateway lo guarda con el TTL
// por defecto y contesta 304 a los condicionales sin tocar al backend.
fn estatico(_req: Request) -> Response {
    let r: Response = response_new(200, "estatico-0123456789abcdef".repeat(2000))
    r.headers_flat.push("ETag")
    r.headers_flat.push("W/\"e2e-1\"")
    return r
}
fn cab(req: Request, nombre: String) -> String {
    var i: int = 0
    while i + 1 < req.headers_flat.length() {
        let k: String = req.headers_flat[i]
        if k.toLower() == nombre {
            let v: String = req.headers_flat[i + 1]
            return v
        }
        i = i + 2
    }
    return ""
}
fn cabeceras(req: Request) -> Response {
    var txt: String = "proto=" + cab(req, "x-forwarded-proto")
    txt = txt + " cookie=" + cab(req, "cookie")
    txt = txt + " xff=" + cab(req, "x-forwarded-for")
    return sin_cache(response_new(200, txt))
}

// Depende de la sesión, SIN Cache-Control: el caso del incidente del 14/11.
fn privado(req: Request) -> Response {
    let c: String = cab(req, "cookie")
    if c.length() > 0 { return response_new(200, "privado de " + c) }
    return response_new(200, "anonimo")
}

// Lo que std/serve entiende de la petición: el formulario, las cookies y el
// nombre exacto con que llegó la cabecera de tipo de contenido.
fn entendido(req: Request) -> Response {
    var fa: String = "?"
    if req.form.contains("a") {
        let v: String = req.form.get("a")
        fa = v
    }
    var cs: String = "?"
    if req.cookies.contains("s") {
        let c: String = req.cookies.get("s")
        cs = c
    }
    let txt: String = "form.a=" + fa + " cookie.s=" + cs + " ctype=" + http_find_header(req.headers_flat, "Content-Type")
    return response_new(200, txt)
}

fn cuenta(_req: Request) -> Response { return sin_cache(response_new(200, int_to_string(sse_count()))) }

fn latido() -> int {
    var n: int = 0
    while true {
        sleep(200)
        n = n + 1
        sse_broadcast("sala", "tick", int_to_string(n))
    }
    return 0
}

fn main() -> int {
    let args: Array = get_args()
    var port: int = 4898
    if args.length() > 1 {
        let p: String = args[1]
        port = string_to_int(p)
    }
    var app: App = app_new()
    app_get(app, "/avisos", avisos)
    app_get(app, "/hola", hola)
    app_get(app, "/lento", lento)
    app_get(app, "/grande", grande)
    app_get(app, "/cabeceras", cabeceras)
    app_get(app, "/cuenta", cuenta)
    app_get(app, "/estatico", estatico)
    app_get(app, "/privado", privado)
    app_post(app, "/eco", eco)
    app_post(app, "/entendido", entendido)
    thread_spawn(latido)
    return serve_app_en(app, "127.0.0.1", port, 16)
}
