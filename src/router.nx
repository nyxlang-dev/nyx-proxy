// router.nx — Route requests to correct upstream by path prefix
// Uses longest-prefix matching, falls back to default upstream
// Includes connection pooling to backends for keep-alive reuse

import "std/http"
import "std/proxy"
import "std/net"
import "src/cache"
import "src/metrics"

// Connection pools: one array of fds per upstream (max 16 upstreams)
var g_pools: Array = []
var g_pool_mtx: Map = Map.new()
var g_pools_init: int = 0

fn pool_init() {
    if g_pools_init == 1 { return 0 }
    g_pool_mtx = mutex_new()
    var i: int = 0
    while i < 16 {
        let pool: Array = []
        g_pools.push(pool)
        i = i + 1
    }
    g_pools_init = 1
    return 0
}

// Get a fd from the pool for upstream idx, or open a new connection
fn pool_get(idx: int, host: String, port: int) -> int {
    mutex_lock(g_pool_mtx)
    let pool: Array = g_pools[idx]
    if pool.length() > 0 {
        let fd: int = pool.pop()
        mutex_unlock(g_pool_mtx)
        return fd
    }
    mutex_unlock(g_pool_mtx)
    // Pool empty — open new connection
    let fd: int = tcp_connect(host, port)
    return fd
}

// Return a fd to the pool (max 16 per upstream), or close it
fn pool_put(idx: int, fd: int) {
    mutex_lock(g_pool_mtx)
    let pool: Array = g_pools[idx]
    if pool.length() < 16 {
        pool.push(fd)
        mutex_unlock(g_pool_mtx)
    } else {
        mutex_unlock(g_pool_mtx)
        tcp_close(fd)
    }
}

// Discard a broken fd (don't return to pool)
fn pool_discard(fd: int) {
    tcp_close(fd)
}

// fds ociosos en el pool de un upstream (tests y diagnóstico).
fn pool_len(idx: int) -> int {
    mutex_lock(g_pool_mtx)
    let pool: Array = g_pools[idx]
    let n: int = pool.length()
    mutex_unlock(g_pool_mtx)
    return n
}

// Tope (bytes) para respuestas cuya longitud NO viene declarada —chunked o
// delimitadas por cierre—: el proxy las junta enteras para reemitirlas con
// Content-Length, así que un upstream roto o malicioso no puede hacerlas crecer
// sin límite. Con Content-Length rige lo declarado (comportamiento previo).
var g_upstream_max_body: int = 16777216

// Plazo de inactividad (s) para un cuerpo delimitado por cierre: sin longitud, el
// único fin posible es que el upstream cierre. Si se queda callado ese tiempo (un
// stream, un SSE, un bug) se corta con 502 en vez de colgar el worker para siempre.
var g_upstream_close_timeout_s: int = 30

fn upstream_set_close_timeout(seconds: int) {
    g_upstream_close_timeout_s = seconds
}

// Tope de túneles SSE simultáneos. Cada túnel retiene el worker que lo atiende
// mientras el stream vive, así que sin tope N clientes SSE dejan al gateway sin
// workers: no degradado, MUDO. El valor real lo pone el consumer según sus
// workers (el gateway de producción usa la mitad de los suyos). OJO: el techo
// EFECTIVO es la cantidad de workers, no este número — al exceder se responde un
// 503 explícito y contabilizado, que es la diferencia entre fallar y desaparecer.
var g_sse_max_tunnels: int = 1024
var g_sse_open: Array = [0]
var g_sse_mtx: Map = Map.new()
var g_sse_mtx_init: int = 0

// Cadencia del loop del túnel (s): cada cuánto se despierta si el upstream está
// callado, que es cuando se sondea si el cliente sigue ahí. No agrega latencia a
// ningún evento: `recv` vuelve apenas hay un byte, no espera el plazo.
var g_sse_idle_s: int = 1

pub fn sse_set_max_tunnels(n: int) {
    g_sse_max_tunnels = n
}

fn sse_init() {
    if g_sse_mtx_init == 1 {
        return 0
    }
    g_sse_mtx = mutex_new()
    g_sse_mtx_init = 1
    return 0
}

// Túneles SSE abiertos ahora (tests y diagnóstico).
pub fn sse_open_count() -> int {
    sse_init()
    mutex_lock(g_sse_mtx)
    let n: int = g_sse_open[0]
    mutex_unlock(g_sse_mtx)
    return n
}

// 1 = hay cupo y queda reservado; 0 = lleno. Reserva y liberación van EN PARES
// dentro de sse_tunnel, para que no exista un camino que reserve y no libere.
fn sse_reserve() -> int {
    sse_init()
    mutex_lock(g_sse_mtx)
    let n: int = g_sse_open[0]
    if n >= g_sse_max_tunnels {
        mutex_unlock(g_sse_mtx)
        return 0
    }
    g_sse_open[0] = n + 1
    mutex_unlock(g_sse_mtx)
    return 1
}

fn sse_release() {
    sse_init()
    mutex_lock(g_sse_mtx)
    g_sse_open[0] = g_sse_open[0] - 1
    mutex_unlock(g_sse_mtx)
    return 0
}

// Inyecta X-Forwarded-For / X-Real-IP en un array de headers parseados
// [k1, v1, k2, v2, ...]. El gateway (que tiene la IP vía getpeername) llama
// esto ANTES de proxy_dispatch/ws_proxy; forward_pooled y el handshake WS
// reenvían headers tal cual, así que los inyectados llegan al upstream.
// Semántica: X-Real-IP entrante se DESCARTA (spoofeable) y se pone la IP
// real; X-Forwarded-For entrante se preserva y se APPENDEA la IP (cadena
// de proxies estándar). Permite rate-limit por IP en los backends.
pub fn inject_forwarded_headers(headers: Array, client_ip: String) -> Array {
    var out: Array = []
    var xff_prev: String = ""
    var i: int = 0
    while i + 1 < headers.length() {
        let hk: String = headers[i]
        let hv: String = headers[i + 1]
        let hk_low: String = hk.toLower()
        if hk_low == "x-real-ip" {
            // descartar: lo setea el gateway
        } else if hk_low == "x-forwarded-for" {
            xff_prev = hv
        } else {
            out.push(hk)
            out.push(hv)
        }
        i = i + 2
    }
    var chain: String = client_ip
    if xff_prev.length() > 0 {
        chain = xff_prev + ", " + client_ip
    }
    out.push("X-Forwarded-For")
    out.push(chain)
    out.push("X-Real-IP")
    out.push(client_ip)
    return out
}

// Forward request to backend using pooled connection
fn forward_pooled_c(idx: int, method: String, path: String, headers: Array, body: String, backend: Backend, tunnel_ok: int) -> Array {
    var fd: int = pool_get(idx, backend.host, backend.port)
    if fd < 0 {
        // Fallo de conexion INICIAL (pool vacio y tcp_connect fallo dentro
        // de pool_get) — el upstream nunca llego a recibir nada, asi que
        // reintentar con una conexion fresca es seguro para CUALQUIER
        // metodo (a diferencia del caso status-line-vacia mas abajo).
        fd = tcp_connect(backend.host, backend.port)
        if fd < 0 {
            return [http_response(502, "Bad Gateway: cannot connect to upstream"), -1]
        }
    }

    // Build HTTP request to upstream
    let crlf: String = "\r\n"
    var req: String = method + " " + path + " HTTP/1.1" + crlf
    req = req + "Host: " + backend.host + ":" + int_to_string(backend.port) + crlf

    // Forward original headers (skip Host, Connection)
    var hi: int = 0
    while hi + 1 < headers.length() {
        let hk: String = headers[hi]
        let hv: String = headers[hi + 1]
        if hk != "Host" and hk != "Connection" {
            req = req + hk + ": " + hv + crlf
        }
        hi = hi + 2
    }

    req = req + "X-Forwarded-Proto: http" + crlf
    req = req + "Connection: keep-alive" + crlf

    if body.length() > 0 {
        req = req + "Content-Length: " + int_to_string(str_byte_length(body)) + crlf
    }

    req = req + crlf + body

    // Send to upstream
    let written: int = tcp_write(fd, req)
    if written <= 0 {
        // Connection stale — discard and retry with new connection
        // (write-fail: el upstream nunca vio el request, retry seguro
        // para cualquier metodo — caso (b), ya existia).
        pool_discard(fd)
        let fd2: int = tcp_connect(backend.host, backend.port)
        if fd2 < 0 {
            return [http_response(502, "Bad Gateway: cannot connect to upstream"), -1]
        }
        tcp_write(fd2, req)
        let res2: Array = read_upstream_response_mc(idx, method, fd2, tunnel_ok)
        return [res2[0], res2[2]]
    }

    let res: Array = read_upstream_response_mc(idx, method, fd, tunnel_ok)
    let resp: String = res[0]
    let was_stale: int = res[1]
    let sse_fd: int = res[2]
    if was_stale == 1 {
        // Status-line vacia: no se leyo NI UN byte de vuelta. Post-restart
        // del upstream esto es el caso tipico (la conexion pooled murio
        // entre requests). Retry con conexion fresca SOLO para metodos
        // idempotentes (GET/HEAD/OPTIONS) — por contrato HTTP no tienen
        // side effects, asi que reenviar el mismo request es seguro. Un
        // POST/PUT/PATCH/DELETE cuya respuesta quedo vacia PUDO haberse
        // ejecutado en el upstream antes de que este muriera; reintentarlo
        // arriesga una doble ejecucion (ej. doble cobro, doble insert) —
        // se prefiere devolver el 502 real y dejar que el cliente decida.
        if method == "GET" or method == "HEAD" or method == "OPTIONS" {
            let fd3: int = tcp_connect(backend.host, backend.port)
            if fd3 < 0 {
                return [resp, -1]
            }
            let written3: int = tcp_write(fd3, req)
            if written3 <= 0 {
                pool_discard(fd3)
                return [resp, -1]
            }
            let res3: Array = read_upstream_response_mc(idx, method, fd3, tunnel_ok)
            return [res3[0], res3[2]]
        }
        return [resp, -1]
    }
    return [resp, sse_fd]
}

// Nombre viejo: String, sin túnel. Lo usan los 11 casos de
// test_proxy_pool_framing directamente, así que su contrato no se toca.
fn forward_pooled(idx: int, method: String, path: String, headers: Array, body: String, backend: Backend) -> String {
    let r: Array = forward_pooled_c(idx, method, path, headers, body, backend, 0)
    return r[0]
}


// Read response from upstream. Retorna [response, was_stale] — was_stale=1
// cuando la status-line vino vacia (NI UN byte leido: conexion pooled
// muerta, tipico post-restart del upstream) para que forward_pooled pueda
// distinguirlo de un 502 real que el backend efectivamente respondio.
//
// ENCUADRE DEL CUERPO Y POOL (seguridad, 2026-09-14). Un fd solo vuelve al pool
// si el cuerpo de ESTA respuesta se leyó completo y su fin era conocido; si no,
// los bytes pendientes quedaban en el socket y el SIGUIENTE pedido que tomaba ese
// fd —quizá de otro usuario— los leía como su respuesta. Antes solo se leía con
// `Content-Length` exacto en mayúsculas. Ahora, según RFC 9112 §6.3:
//   - HEAD, 1xx, 204 y 304 no tienen cuerpo (los 1xx provisionales se saltan);
//   - Transfer-Encoding con `chunked` final se lee hasta el chunk 0 y trailers;
//     con TE y Content-Length a la vez gana chunked y el fd NO se reusa
//     (señal de request smuggling);
//   - Content-Length válido se lee exacto; si llegan menos bytes, 502;
//   - sin longitud: delimitado por cierre — se lee hasta EOF con plazo y tope,
//     y el fd se descarta siempre.
// Las cabeceras se comparan sin mayúsculas. Chunked se DESAGRUPA y se reemite
// con Content-Length: el gateway escribe la respuesta entera de una vez y la
// cache guarda respuestas con longitud (el «off-by-8»), así que reemitir chunked
// obligaría a enseñarle ese encuadre a los dos sin ganar nada.
fn read_upstream_response(upstream_idx: int, fd: int) -> Array {
    return read_upstream_response_m(upstream_idx, "GET", fd)
}

fn upstream_bad(fd: int, msg: String) -> Array {
    pool_discard(fd)
    let r: String = http_response(502, "Bad Gateway: " + msg)
    return [r, 0]
}

// Igual, para la variante de 3 elementos: no hay fd que tunelizar (-1).
fn upstream_bad_t(fd: int, msg: String) -> Array {
    let r: Array = upstream_bad(fd, msg)
    return [r[0], r[1], -1]
}

// Entero decimal no negativo; -1 si no lo es.
fn parse_decimal_len(v: String) -> int {
    let s: String = v.trim()
    let n: int = str_byte_length(s)
    if n == 0 or n > 18 {
        return -1
    }
    var r: int = 0
    var i: int = 0
    while i < n {
        let c: int = s.charAt(i)
        if c < 48 or c > 57 {
            return -1
        }
        r = r * 10 + (c - 48)
        i = i + 1
    }
    return r
}

// Tamaño de chunk en hexadecimal, con extensiones `;...` opcionales; -1 si es inválido.
fn parse_chunk_size(line: String) -> int {
    var s: String = line
    let semi: int = s.indexOf(";")
    if semi >= 0 {
        s = s.substring(0, semi)
    }
    s = s.trim()
    let n: int = str_byte_length(s)
    if n == 0 or n > 15 {
        return -1
    }
    var v: int = 0
    var i: int = 0
    while i < n {
        let c: int = s.charAt(i)
        var d: int = -1
        if c >= 48 and c <= 57 {
            d = c - 48
        } else if c >= 97 and c <= 102 {
            d = c - 87
        } else if c >= 65 and c <= 70 {
            d = c - 55
        }
        if d < 0 {
            return -1
        }
        v = v * 16 + d
        i = i + 1
    }
    return v
}

// "HTTP/1.1 NNN reason" -> NNN; <= 0 si la status-line está mal formada.
fn status_code_of(status_line: String) -> int {
    let sp: int = status_line.indexOf(" ")
    if sp < 0 {
        return 0
    }
    if str_byte_length(status_line) < sp + 4 {
        return 0
    }
    let digits: String = status_line.substring(sp + 1, sp + 4)
    return parse_decimal_len(digits)
}

// ¿El Content-Type de la respuesta es un canal SSE? Se corta en el primer `;`
// porque el valor real trae parámetros (`text/event-stream; charset=utf-8`), y se
// compara por IGUALDAD, no por prefijo: `text/event-streamx` es otro tipo y con
// startsWith entraría al túnel.
fn is_event_stream(ct: String) -> int {
    var base: String = ct
    let semi: int = ct.indexOf(";")
    if semi >= 0 {
        base = ct.substring(0, semi)
    }
    if base.trim().toLower() == "text/event-stream" {
        return 1
    }
    return 0
}

// Cuerpo chunked completo. Retorna [1, cuerpo, reusable] o [0, motivo, 0].
// reusable=0 cuando el upstream cerró entre el chunk 0 y la línea vacía final:
// el cuerpo ya está entero, pero ese fd está muerto y en el pool haría fallar
// al pedido siguiente (un POST no se reintenta: le tocaría un 502 ajeno).
// `tcp_read_line` devuelve "" tanto en línea vacía como en EOF, por eso los
// trailers se leen con la variante Result, que separa los dos casos.
fn read_chunked_body(fd: int) -> Array {
    var body: String = ""
    var total: int = 0
    while 1 > 0 {
        let size_line: String = tcp_read_line(fd)
        let size: int = parse_chunk_size(size_line)
        if size < 0 {
            return [0, "invalid chunk size from upstream", 0]
        }
        if size == 0 {
            var tdone: int = 0
            var t_reusable: int = 1
            while tdone == 0 {
                match try_tcp_read_line(fd) {
                    Result.Ok(t) => {
                        if t.length() == 0 {
                            tdone = 1
                        }
                    }
                    Result.Err(e) => {
                        t_reusable = 0
                        tdone = 1
                    }
                }
            }
            return [1, body, t_reusable]
        }
        if total + size > g_upstream_max_body {
            return [0, "chunked response exceeds the proxy limit", 0]
        }
        let data: String = tcp_read(fd, size)
        if str_byte_length(data) != size {
            return [0, "truncated chunk from upstream", 0]
        }
        body = body + data
        total = total + size
        let term: String = tcp_read_line(fd)
        if term.length() != 0 {
            return [0, "malformed chunk terminator from upstream", 0]
        }
    }
    return [0, "unreachable", 0]
}

// Cuerpo delimitado por cierre, con plazo de INACTIVIDAD y tope. El plazo es
// SO_RCVTIMEO: vence si el upstream pasa ese tiempo sin mandar un byte, no es una
// duración total (un goteo lento sigue hasta el tope). Retorna [1, cuerpo] o [0, motivo].
fn read_until_close(fd: int) -> Array {
    tcp_set_timeout(fd, g_upstream_close_timeout_s)
    var body: String = ""
    var total: int = 0
    var fin: int = 0
    var chunk: String = ""
    var err_kind: String = ""
    while fin == 0 {
        chunk = ""
        match try_tcp_read_partial(fd, 65536) {
            Result.Ok(s) => { chunk = s }
            Result.Err(e) => { err_kind = e.kind }
        }
        if err_kind.length() > 0 {
            return [0, "response without length idle for " + int_to_string(g_upstream_close_timeout_s) + "s (" + err_kind + ")"]
        }
        let clen: int = str_byte_length(chunk)
        if clen == 0 {
            fin = 1
        } else {
            total = total + clen
            if total > g_upstream_max_body {
                return [0, "response without length exceeds the proxy limit"]
            }
            body = body + chunk
        }
    }
    return [1, body]
}

fn read_upstream_response_mc(upstream_idx: int, method: String, fd: int, tunnel_ok: int) -> Array {
    var status_line: String = tcp_read_line(fd)
    if status_line.length() == 0 {
        pool_discard(fd)
        let stale_resp: String = http_response(502, "Bad Gateway: empty response from upstream")
        return [stale_resp, 1, -1]
    }
    var code: int = status_code_of(status_line)

    // Headers (y respuestas 1xx provisionales, que se saltan)
    var resp_headers: Array = []
    var cl_raw: String = ""
    var cl_conflict: int = 0
    var te_raw: String = ""
    var ct_raw: String = ""
    var conn_close: int = 0
    var conn_keepalive: int = 0
    var interim: int = 1
    var hdone: int = 0
    while interim == 1 {
        resp_headers = []
        cl_raw = ""
        cl_conflict = 0
        te_raw = ""
        ct_raw = ""
        conn_close = 0
        conn_keepalive = 0
        hdone = 0
        while hdone == 0 {
            let line: String = tcp_read_line(fd)
            if line.length() == 0 {
                hdone = 1
            } else {
                let colon_idx: int = line.indexOf(":")
                if colon_idx > 0 {
                    let key: String = line.substring(0, colon_idx)
                    let raw_val: String = line.substring(colon_idx + 1, line.length())
                    let val: String = raw_val.trim()
                    let kl: String = key.toLower()
                    if kl == "content-length" {
                        if cl_raw.length() > 0 and cl_raw != val {
                            cl_conflict = 1
                        }
                        cl_raw = val
                    } else if kl == "transfer-encoding" {
                        if te_raw.length() > 0 {
                            te_raw = te_raw + ", " + val
                        } else {
                            te_raw = val
                        }
                    } else if kl == "content-type" {
                        ct_raw = val
                    } else if kl == "connection" {
                        let vl: String = val.toLower()
                        if vl.indexOf("close") >= 0 {
                            conn_close = 1
                        }
                        if vl.indexOf("keep-alive") >= 0 {
                            conn_keepalive = 1
                        }
                    }
                    resp_headers.push(key)
                    resp_headers.push(val)
                }
            }
        }
        if code >= 100 and code < 200 and code != 101 {
            status_line = tcp_read_line(fd)
            if status_line.length() == 0 {
                return upstream_bad_t(fd, "upstream closed after an interim 1xx response")
            }
            code = status_code_of(status_line)
        } else {
            interim = 0
        }
    }
    if code <= 0 {
        return upstream_bad_t(fd, "malformed status line from upstream")
    }

    // Honor upstream's Connection: close (en cualquier capitalización) y el
    // default de HTTP/1.0 — don't pool a fd the server is about to close.
    var reusable: int = 1
    if conn_close == 1 {
        reusable = 0
    }
    if status_line.startsWith("HTTP/1.0") and conn_keepalive == 0 {
        reusable = 0
    }
    if code == 101 {
        reusable = 0
    }
    var no_body: int = 0
    if method == "HEAD" or code == 204 or code == 304 or code < 200 {
        no_body = 1
    }

    // ── Canal SSE: el cuerpo NO se lee acá, se tuneliza ──────────────────────
    // Solo si el caller tiene a quién escribirle (tunnel_ok). Con el flag
    // apagado —standalone, un worker sin sink, los tests de encuadre— ni se
    // evalúa el Content-Type y el camino de abajo queda byte-idéntico al de
    // antes de este cambio.
    //
    // Se exige AUSENCIA de Content-Length y de Transfer-Encoding: si el upstream
    // encuadró la respuesta, el encuadre alcanza y el fd puede seguir en el pool.
    // `std/serve` nunca manda ninguno de los dos, así que el camino real entra
    // entero. El fd se devuelve SIN pool_put ni pool_discard: de cerrarlo se
    // encarga el túnel, y volver al pool es justamente lo que no puede pasar.
    if tunnel_ok == 1 and no_body == 0 and cl_raw.length() == 0 and te_raw.length() == 0 and is_event_stream(ct_raw) == 1 {
        let crlf_s: String = "\r\n"
        var head: String = status_line + crlf_s
        var si: int = 0
        while si + 1 < resp_headers.length() {
            let sk: String = resp_headers[si]
            let sv: String = resp_headers[si + 1]
            let skl: String = sk.toLower()
            // Se filtran las tres de encuadre y se relaya todo lo demás tal
            // cual: Content-Type, Cache-Control y X-Accel-Buffering vienen del
            // upstream y son justamente lo que evita que el cliente bufferice.
            // NO se puede reusar la reemisión normal de más abajo: recalcula un
            // Content-Length que acá no existe (el cuerpo puede ser infinito) y
            // pone Connection: keep-alive, que sin longitud deja al cliente sin
            // ningún delimitador de cuerpo.
            if skl != "connection" and skl != "content-length" and skl != "transfer-encoding" {
                head = head + sk + ": " + sv + crlf_s
            }
            si = si + 2
        }
        head = head + "Connection: close" + crlf_s + crlf_s
        return [head, 0, fd]
    }

    // Read response body
    var resp_body: String = ""
    if no_body == 0 {
        if te_raw.length() > 0 {
            if cl_raw.length() > 0 {
                reusable = 0
            }
            let te_low: String = te_raw.toLower()
            if te_low.endsWith("chunked") {
                let cr: Array = read_chunked_body(fd)
                let c_ok: int = cr[0]
                let c_data: String = cr[1]
                if c_ok != 1 {
                    return upstream_bad_t(fd, c_data)
                }
                let c_reusable: int = cr[2]
                if c_reusable != 1 {
                    reusable = 0
                }
                resp_body = c_data
            } else {
                reusable = 0
                let ur: Array = read_until_close(fd)
                let u_ok: int = ur[0]
                let u_data: String = ur[1]
                if u_ok != 1 {
                    return upstream_bad_t(fd, u_data)
                }
                resp_body = u_data
            }
        } else if cl_raw.length() > 0 {
            if cl_conflict == 1 {
                return upstream_bad_t(fd, "conflicting Content-Length headers from upstream")
            }
            let content_length: int = parse_decimal_len(cl_raw)
            if content_length < 0 {
                return upstream_bad_t(fd, "invalid Content-Length from upstream")
            }
            if content_length > 0 {
                resp_body = tcp_read(fd, content_length)
                if str_byte_length(resp_body) != content_length {
                    return upstream_bad_t(fd, "truncated response body from upstream")
                }
            }
        } else {
            reusable = 0
            let ur2: Array = read_until_close(fd)
            let u2_ok: int = ur2[0]
            let u2_data: String = ur2[1]
            if u2_ok != 1 {
                return upstream_bad_t(fd, u2_data)
            }
            resp_body = u2_data
        }
    }

    // Return fd to pool for reuse — solo con el cuerpo leído entero y su fin conocido
    if reusable == 1 {
        pool_put(upstream_idx, fd)
    } else {
        pool_discard(fd)
    }

    // Build response to client
    let crlf: String = "\r\n"
    var response: String = status_line + crlf

    var ri: int = 0
    while ri + 1 < resp_headers.length() {
        let rk: String = resp_headers[ri]
        let rv: String = resp_headers[ri + 1]
        let rkl: String = rk.toLower()
        var keep: int = 1
        if rkl == "connection" {
            keep = 0
        }
        if no_body == 0 {
            if rkl == "content-length" or rkl == "transfer-encoding" {
                keep = 0
            }
        }
        if keep == 1 {
            response = response + rk + ": " + rv + crlf
        }
        ri = ri + 2
    }
    if no_body == 0 {
        response = response + "Content-Length: " + int_to_string(str_byte_length(resp_body)) + crlf
    }

    response = response + "Connection: keep-alive" + crlf
    response = response + crlf + resp_body

    return [response, 0, -1]
}

// Variante de 3 elementos, con el destino del fd decidido por el caller. El
// nombre viejo queda como wrapper de 2 elementos con el túnel APAGADO: los 11
// casos de test_proxy_pool_framing y cualquier consumer sin socket de cliente a
// mano siguen viendo exactamente el contrato de antes.
fn read_upstream_response_m(upstream_idx: int, method: String, fd: int) -> Array {
    let r: Array = read_upstream_response_mc(upstream_idx, method, fd, 0)
    return [r[0], r[1]]
}


// Detect MIME type from file extension
fn detect_mime_type(file_path: String) -> String {
    if file_path.endsWith(".css") { return "text/css; charset=utf-8" }
    if file_path.endsWith(".js") { return "application/javascript; charset=utf-8" }
    if file_path.endsWith(".svg") { return "image/svg+xml" }
    if file_path.endsWith(".png") { return "image/png" }
    if file_path.endsWith(".woff2") { return "font/woff2" }
    if file_path.endsWith(".woff") { return "font/woff" }
    if file_path.endsWith(".html") { return "text/html; charset=utf-8" }
    if file_path.endsWith(".json") { return "application/json; charset=utf-8" }
    return "application/octet-stream"
}

// ── WebSocket proxying ──────────────────────────────────────────────────────
// Resuelve el índice de upstream y el largo de prefix para (host, path). Duplica
// la lógica de routing de proxy_dispatch (vhost two-pass → prefix → default) SIN
// tocar proxy_dispatch (que tiene cache/singleflight en producción). Devuelve
// [best_idx, best_len]; best_idx < 0 si no hay upstream configurado.
fn resolve_upstream_idx(host_name: String, path: String) -> Array {
    var best_idx: int = -1
    var best_len: int = 0
    var vhost_catchall_idx: int = -1
    var vi: int = 0
    while vi < g_vhost_count {
        let vname: String = g_vhost_names[vi]
        if vname == host_name {
            let upstream_idx: int = g_vhost_indices[vi]
            let prefix: String = g_upstream_prefixes[upstream_idx]
            let plen: int = prefix.length()
            if plen == 0 {
                if vhost_catchall_idx < 0 {
                    vhost_catchall_idx = upstream_idx
                }
            } else {
                if path.startsWith(prefix) {
                    if plen > best_len {
                        best_idx = upstream_idx
                        best_len = plen
                    }
                }
            }
        }
        vi = vi + 1
    }
    if best_idx < 0 and vhost_catchall_idx >= 0 {
        best_idx = vhost_catchall_idx
    }
    if best_idx < 0 {
        var i: int = 0
        while i < g_upstream_count {
            let prefix: String = g_upstream_prefixes[i]
            let plen: int = prefix.length()
            if plen > 0 {
                if path.startsWith(prefix) {
                    if plen > best_len {
                        best_idx = i
                        best_len = plen
                    }
                }
            }
            i = i + 1
        }
    }
    if best_idx < 0 {
        best_idx = g_default_upstream
    }
    var res: Array = []
    res.push(best_idx)
    res.push(best_len)
    return res
}

// Túnel bidireccional cliente(TLS) ↔ upstream(TCP) hasta que un lado cierre.
// 1 thread para upstream→cliente (closure capturando los handles), inline para
// cliente→upstream. Cuando el cliente cierra, shutdown del upstream desbloquea el
// thread.
//
// Lock SSL poll-then-lock (RESUELVE la limitación piloto que documentaba esta
// función: SSL_read/SSL_write concurrentes sin lock sobre el mismo SSL*).
// `ssl_mtx` serializa el acceso al SSL* entre el writer (up_to_client, bajo
// lock) y el reader (loop inline). El reader NUNCA toma el lock para un read
// potencialmente bloqueante: primero `tls_wait_readable` SIN el lock — pero
// OJO, "sin lock" no es "no toca el SSL*": internamente llama SSL_pending()
// y SSL_get_fd() sobre el mismo `ssl_handle` que el writer puede estar
// usando bajo `ssl_mtx` en simultaneo (runtime/tls.c). Es seguro igual porque
// ambas son lecturas de solo el LADO RECEPTOR del SSL* (SSL_pending mira el
// buffer de bytes ya decodificados que llega por el read-path, SSL_get_fd
// solo lee un puntero fijo del struct) — ninguna toca el estado de escritura
// (SSL_write) que usa el writer, asi que no hay carrera real, solo ausencia
// de serializacion formal sobre un dato que el writer nunca muta. Recien si
// `tls_wait_readable` dice "hay algo" el reader toma el lock para
// un `tls_read_nonblock` (garantizado no-bloqueante) antes de soltarlo. Bajo
// el lock SOLO van operaciones no-bloqueantes (tls_read_nonblock /
// tls_write_conn) — un tls_read_partial (bloqueante) bajo el lock
// dead-lockearia al writer si el wakeup de poll() resulta ser solo un
// record de control TLS 1.3 (p.ej. NewSessionTicket post-handshake) sin
// datos de aplicación detrás: el SSL_read subsiguiente se quedaria
// esperando mas bytes CON el lock tomado. Caveat documentado en
// runtime/tls.c (nyx_tls_wait_readable / nyx_tls_read_nonblock).
//
// El flag `up_closed` (closure sobre un Array de 1 elemento, seteado por el
// writer al ver EOF del upstream) destraba el cuelgue "upstream cierra
// primero": antes, si el upstream cerraba antes que el cliente, el reader
// inline quedaba bloqueado indefinidamente en un read TLS esperando algo
// del cliente, sin enterarse nunca de que ya no habia adonde reenviarlo.
// Ahora el reader hace poll con timeout (1s) y revisa el flag en cada
// timeout, asi que sale del loop apenas el writer termino. El simetrico
// "cliente cierra primero" (FIN del lado TLS) ya no depende de este flag: lo
// resuelve el runtime — `tls_wait_readable` ahora detecta EOF real del peer
// (via el flag `h->eof` que setea `tls_read_nonblock` al ver close_notify o
// un error fatal) y devuelve -1 DETERMINISTICO en vez de reportar POLLIN
// para siempre, asi que el `else` (-1) del loop de abajo corta sin
// busy-spin apenas el cliente termina (review final pre-push, monorepo
// runtime/tls.c).
fn ws_tunnel(ssl_handle: int, up_fd: int) {
    let ssl_mtx: Map = mutex_new()
    // Flag cross-thread SIN lock/atomic dedicado (lector: este loop;
    // escritor: up_to_client abajo) — benigno: es un int word-aligned (sin
    // torn writes en ARM64/x86-64), se escribe UNA sola vez (0->1, nunca
    // vuelve a 0) y se relee en cada timeout de poll de 1s del loop de abajo,
    // asi que en el peor caso una lectura stale retrasa la salida del loop un
    // ciclo (~1s), nunca lo corrompe ni lo cuelga indefinidamente.
    var up_closed: Array = [0]

    fn up_to_client() -> int {
        var done: int = 0
        while done == 0 {
            let s: String = tcp_read_partial(up_fd, 65536)
            if s.length() == 0 {
                done = 1
                up_closed[0] = 1
            } else {
                mutex_lock(ssl_mtx)
                tls_write_conn(ssl_handle, s)
                mutex_unlock(ssl_mtx)
            }
        }
        return 0
    }
    let tid: int = thread_spawn(up_to_client)

    var cdone: int = 0
    while cdone == 0 {
        let w: int = tls_wait_readable(ssl_handle, 1000)
        if w == 1 {
            mutex_lock(ssl_mtx)
            let s: String = tls_read_nonblock(ssl_handle, 65536)
            mutex_unlock(ssl_mtx)
            if s.length() > 0 {
                tcp_write(up_fd, s)
            }
            // s == "" -> el wakeup era solo un record de control TLS (o un
            // WANT_READ del nonblock) sin datos de aplicacion; la muerte
            // real de la conexion la detecta el -1 del proximo wait, o el
            // proximo write al upstream. Volver a esperar.
        } else if w == 0 {
            if up_closed[0] == 1 {
                cdone = 1
            }
            // si no, el timeout es normal (nada que leer todavia) — seguir
            // esperando.
        } else {
            // -1: conexion muerta / HUP sin data.
            cdone = 1
        }
    }
    // Cliente (o upstream) determino el fin: shutdown del upstream desbloquea
    // el read del thread relay si seguia esperando datos; join garantiza que
    // ese thread terminó de escribir al SSL ANTES de cerrarlo (evita SSL_free
    // concurrente con SSL_write).
    tcp_shutdown(up_fd, 2)
    thread_join(tid)
    tcp_close(up_fd)
    tls_close_conn(ssl_handle)
    return 0
}

// ── Túnel SSE: UN SOLO SENTIDO, upstream → cliente ───────────────────────────
//
// ASIMETRÍA DELIBERADA con ws_tunnel, que está acá arriba: aquel es
// BIDIRECCIONAL y por eso necesita 2 threads y el `ssl_mtx`. En SSE el cliente
// no manda NADA después del GET, así que un segundo thread solo existiría para
// bloquearse leyendo un socket mudo. Un único thread toca el SSL ⇒ no hace falta
// mutex, y NO aplica el caveat de NewSessionTicket (nunca hay un read bloqueante
// compitiendo con un write bajo el mismo lock). Si alguien viene a "unificar las
// dos", esto es lo que se pierde.
//
// La muerte del cliente se detecta por DOS vías independientes, las dos gratis:
// la sonda del ciclo ocioso (cuando el upstream no tenía nada que relayar, así
// que no retrasa ningún byte real) y el resultado de la escritura, que hay que
// mirar igual. No alcanza con la segunda sola: con el heartbeat de 15 s de
// `std/serve`, y sabiendo que el primer write tras un cierre normal entra al
// buffer del kernel y recién falla el segundo, un cliente que cierra la pestaña
// tardaría entre 15 y 30 s en notarse — con un worker clavado todo ese rato.
//
// PROPIEDAD DE LOS SOCKETS, otra diferencia con ws_tunnel: esta función es dueña
// SOLO de up_fd (shutdown + close). El socket del cliente lo cierra el CALLER,
// como en todo el camino de proxy_dispatch: ws_tunnel cierra el SSL porque
// ws_proxy le transfiere la conexión entera, acá no, y cerrarlo sería un doble
// free contra el tls_close_conn del worker.

// Escritura al cliente, indistinta del transporte. Devuelve bytes escritos.
fn sse_client_write(ssl_handle: int, client_fd: int, s: String) -> int {
    if ssl_handle > 0 {
        return tls_write_conn(ssl_handle, s)
    }
    return tcp_write(client_fd, s)
}

// 1 = el cliente sigue vivo; 0 = se fue.
fn sse_client_alive(ssl_handle: int, client_fd: int) -> int {
    if ssl_handle > 0 {
        let w: int = tls_wait_readable(ssl_handle, 0)
        if w < 0 {
            return 0
        }
        if w == 1 {
            // OBLIGATORIO consumir: tls_wait_readable cortocircuita en su buffer
            // propio y en SSL_pending ANTES de mirar el flag de EOF, y ese flag
            // solo lo setea tls_read_nonblock. Sin este read, un peer que ya
            // mandó close_notify devuelve 1 para siempre = busy-spin al 100%.
            // Lo leído se DESCARTA: un cliente SSE no habla, y la respuesta va
            // con `Connection: close`, así que no hay pedido siguiente que
            // pudiera venir pipelineado acá.
            let junk: String = tls_read_nonblock(ssl_handle, 4096)
            if junk.length() >= 0 {
                return 1
            }
        }
        return 1
    }
    // Camino plano: NO existe un `tcp_wait_readable` en el runtime, así que la
    // sonda es un read de 1 byte contra el SO_RCVTIMEO ya puesto. Es correcta
    // (nunca pierde bytes) pero menos fina que el poll de 0 ms del lado TLS.
    var alive: int = 1
    match try_tcp_read_partial(client_fd, 1) {
        Result.Ok(s) => {
            // Ok("") es EOF limpio e inambiguo en la variante Result: el cliente
            // cerró. Ok(datos) sería pipelining, que acá se descarta.
            if str_byte_length(s) == 0 {
                alive = 0
            }
        }
        Result.Err(e) => {
            // 11 = EAGAIN: venció el plazo y el cliente sigue vivo y callado,
            // que es el caso NORMAL en SSE. Se discrimina por `code` y no por
            // `kind` a propósito: el 11 no está en errno_to_kind y cae al
            // catch-all "io", indistinguible de un error de verdad.
            if e.code != 11 {
                alive = 0
            }
        }
    }
    return alive
}

// Relaya el stream hasta que cualquiera de los dos extremos corte.
// Devuelve 0 = el túnel corrió (y up_fd quedó cerrado);
//          1 = RECHAZADO por cupo (up_fd ya descartado, el caller manda 503).
fn sse_tunnel(ssl_handle: int, client_fd: int, up_fd: int, head: String) -> int {
    if sse_reserve() == 0 {
        pool_discard(up_fd)
        return 1
    }

    // El SO_RCVTIMEO del upstream ES el reloj del loop. OJO: un valor <= 0 lo
    // DESACTIVA (bloqueo indefinido), así que 1 es el mínimo utilizable.
    tcp_set_timeout(up_fd, g_sse_idle_s)
    if ssl_handle <= 0 {
        // Plano: acota la sonda Y el send() contra un cliente trabado. Del lado
        // TLS no hace falta, tls_accept ya dejó su propio plazo en el fd.
        tcp_set_timeout(client_fd, g_sse_idle_s + 1)
    }

    // La cabecera se escribe ACÁ y no en el caller, para que la reserva y la
    // liberación del cupo queden emparejadas dentro de una sola función.
    var done: int = 0
    let hlen: int = str_byte_length(head)
    if sse_client_write(ssl_handle, client_fd, head) != hlen {
        done = 1
    }

    while done == 0 {
        var chunk: String = ""
        var eof: int = 0
        var err: int = 0
        var ecode: int = 0
        // Drena primero lo que tcp_read_line dejó en el buffer de conexión al
        // parsear las cabeceras: los bytes del primer evento que viajaron en el
        // MISMO segmento que la cabecera no se pierden.
        match try_tcp_read_partial(up_fd, 65536) {
            Result.Ok(s) => {
                if str_byte_length(s) == 0 {
                    eof = 1
                } else {
                    chunk = s
                }
            }
            Result.Err(e) => {
                err = 1
                ecode = e.code
            }
        }

        if eof == 1 {
            // EOF limpio del upstream: fin NORMAL del stream. `std/serve` manda
            // `: cierre\n\n` y después el FIN.
            done = 1
        } else if err == 1 {
            if ecode == 11 {
                // EAGAIN: venció el tick sin datos, el caso normal entre
                // heartbeats. ÚNICO momento en que se sondea al cliente.
                if sse_client_alive(ssl_handle, client_fd) == 0 {
                    done = 1
                }
            } else {
                done = 1
            }
        } else {
            let want: int = str_byte_length(chunk)
            let wrote: int = sse_client_write(ssl_handle, client_fd, chunk)
            // Comparar contra el largo esperado, NUNCA `wrote > 0`: tls_write_conn
            // puede devolver una escritura PARCIAL si un SSL_write intermedio
            // falla, y un frame SSE partido a la mitad no se puede reanudar.
            if wrote != want {
                done = 1
            }
        }
    }

    if ssl_handle <= 0 {
        // Devolver el socket aceptado a su bloqueo indefinido original.
        tcp_set_timeout(client_fd, 0)
    }
    // shutdown antes del close: el FIN sale YA y el upstream saca este fd de su
    // registro en su próxima escritura, en vez de seguir latiendo contra un
    // socket muerto. (Acá no hay un segundo thread que despertar — ese es el
    // motivo del shutdown en ws_tunnel, no el de acá.)
    tcp_shutdown(up_fd, 2)
    tcp_close(up_fd)
    sse_release()
    return 0
}

// Maneja una conexión WebSocket entrante (el gateway ya detectó el Upgrade).
// Resuelve backend, abre conexión DEDICADA (sin pool — WS retiene el socket),
// reenvía el handshake crudo preservando Upgrade/Connection/Sec-WebSocket-*,
// relaya la respuesta (101) y tuneliza. Retorna cuando el túnel cierra.
pub fn ws_proxy(ssl_handle: int, method: String, path: String, headers: Array, host_name: String) {
    let res: Array = resolve_upstream_idx(host_name, path)
    let best_idx: int = res[0]
    let best_len: int = res[1]
    if best_idx < 0 {
        tls_write_conn(ssl_handle, http_response(502, "no upstream for websocket"))
        return 0
    }
    let cfg: ProxyConfig = g_upstream_configs[best_idx]
    let backend: Backend = select_backend(cfg)

    var forward_path: String = path
    if best_len > 0 {
        forward_path = path.substring(best_len, path.length())
        if forward_path.length() == 0 {
            forward_path = "/"
        }
    }

    let up_fd: int = tcp_connect(backend.host, backend.port)
    if up_fd < 0 {
        tls_write_conn(ssl_handle, http_response(502, "websocket upstream unreachable"))
        return 0
    }

    // Reenviar el handshake CRUDO al upstream: request line + headers originales
    // (Host reescrito al backend; preservar Upgrade / Connection: Upgrade / Sec-WebSocket-*).
    let crlf: String = "\r\n"
    var req: String = method + " " + forward_path + " HTTP/1.1" + crlf
    req = req + "Host: " + backend.host + ":" + int_to_string(backend.port) + crlf
    var hi: int = 0
    while hi + 1 < headers.length() {
        let hk: String = headers[hi]
        let hv: String = headers[hi + 1]
        if hk != "Host" {
            req = req + hk + ": " + hv + crlf
        }
        hi = hi + 2
    }
    req = req + crlf
    tcp_write(up_fd, req)

    // Relayar la respuesta del upstream (status line + headers) al cliente.
    // La 1ª línea es la status line: solo tunelizamos si es 101 Switching
    // Protocols. Si el upstream RECHAZA el handshake (4xx/5xx) con keep-alive,
    // entrar al túnel colgaría el worker TLS para siempre (ni cliente ni
    // upstream envían nada). En ese caso relayamos la respuesta y cerramos.
    // EN: only tunnel on a 101; a rejected handshake would otherwise hang the
    // TLS worker forever, so relay the response and close instead.
    var resp: String = ""
    var rdone: int = 0
    var status_line: String = ""
    var first: int = 1
    while rdone == 0 {
        let line: String = tcp_read_line(up_fd)
        if first == 1 {
            status_line = line
            first = 0
        }
        if line.length() == 0 {
            resp = resp + crlf
            rdone = 1
        } else {
            resp = resp + line + crlf
        }
    }
    tls_write_conn(ssl_handle, resp)

    if status_line.indexOf(" 101 ") < 0 {
        // No es un upgrade aceptado — no tunelizar, cerrar el upstream.
        tcp_close(up_fd)
        return 0
    }

    // Túnel bidireccional hasta cierre.
    ws_tunnel(ssl_handle, up_fd)
    return 0
}

// Variante con el socket del cliente a la vista, que es lo que permite tunelizar
// en vez de acumular. Convención del sink: ssl_handle > 0 ⇒ TLS; ssl_handle == 0
// y client_fd >= 0 ⇒ plano; ninguno de los dos ⇒ sin sink, y entonces el camino
// es exactamente el de siempre.
// A diferencia del upgrade WebSocket —que se detecta en el REQUEST, antes de
// tocar el upstream— un canal SSE solo se reconoce en la RESPUESTA, así que la
// decisión se toma después de leer las cabeceras del upstream.
// Devuelve "" cuando ya no queda nada que escribirle al cliente (túnel hecho, o
// cliente ido): los dos workers del gateway ya chequean eso antes de escribir.
pub fn proxy_dispatch_c(raw: Array, ssl_handle: int, client_fd: int) -> String {
    let method: String = raw[1]
    let path: String = raw[2]
    let headers: Array = raw[3]
    let body: String = raw[4]

    // Empty method = client disconnected
    if method.length() == 0 {
        return ""
    }

    // MEDIDO EN MICROSEGUNDOS, y con reloj MONOTÓNICO. Las dos cosas importan:
    //  · `access_log` y `metrics_record_request` reciben `latency_us` y dividen
    //    entre 1000. Acá se medía con `time_epoch()`, que da SEGUNDOS, así que
    //    una petición de 300 ms entraba como 0 y hacía falta que una tardara
    //    1000 s para registrar 1 ms. En la práctica el access log escribía
    //    «0ms» en todas sus líneas y el histograma de latencia metía TODO en el
    //    primer bucket (le="1"): las métricas de latencia del proxy eran ruido.
    //    Tercer bug de la misma familia de escalas tras 0502bec y 1c2bc18; los
    //    dos anteriores se arreglaron y este sobrevivió porque ninguna suite
    //    miraba el valor, solo el formato.
    //  · una DURACIÓN no se mide con el reloj de pared: un salto de NTP hacia
    //    atrás daba latencias negativas. Es el mismo motivo por el que
    //    `metrics_init` ya usaba el reloj monotónico para el uptime.
    let t_start: int = monotonic_us()

    // Initialize pools on first call
    pool_init()

    // /shared/* static assets are served by each backend via app_static().
    // No inline handler needed here — let the request fall through to the
    // upstream so the correct site serves its own copy of the design system.

    // Virtual host routing: match Host header first
    let host_header: String = http_find_header(headers, "Host")
    // Strip port from Host header (e.g. "nyxkv.com:443" -> "nyxkv.com")
    var host_name: String = host_header
    let colon_pos: int = host_header.indexOf(":")
    if colon_pos >= 0 {
        host_name = host_header.substring(0, colon_pos)
    }

    // Cache lookup antes de tocar backend. Solo GET — el contrato de
    // HTTP dice que otros metodos tienen side effects que no cachear.
    var sf_claimed: int = 0
    if g_cache_enabled == 1 {
        if method == "GET" {
            let cached: String = cache_lookup(host_name, path)
            if cached.length() > 0 {
                let resp_hit: String = cache_mark_hit(cached)
                let t_hit: int = monotonic_us()
                access_log(method, path, 200, t_hit - t_start)
                metrics_record_request(host_name, 200, t_hit - t_start, 1)
                return resp_hit
            }
            // Miss — intentar claim singleflight. Si otro thread ya fetcha,
            // esperar hasta 3s a que cachee y reusar.
            sf_claimed = singleflight_claim(host_name, path)
            if sf_claimed == 0 {
                let sf_hit: String = singleflight_wait(host_name, path, 3000)
                if sf_hit.length() > 0 {
                    let resp_sf: String = cache_mark_hit(sf_hit)
                    let t_sf: int = monotonic_us()
                    access_log(method, path, 200, t_sf - t_start)
                    metrics_record_request(host_name, 200, t_sf - t_start, 1)
                    return resp_sf
                }
                // Timeout o fetcher descarto — fall through al backend por
                // nuestra cuenta (degradacion benigna; re-claim explicito).
                sf_claimed = singleflight_claim(host_name, path)
            }
        }
    }

    var best_idx: int = -1
    var best_len: int = 0

    // Virtual host routing: longest path_prefix wins under matching hostname,
    // falling back to the bare-hostname (catch-all) upstream when no
    // path_prefix matches. Without this two-pass, a vhost without
    // path_prefix would shadow any vhost+path_prefix declared after it for
    // the same hostname, even when the prefix matched the request path.
    var vhost_catchall_idx: int = -1
    var vi: int = 0
    while vi < g_vhost_count {
        let vname: String = g_vhost_names[vi]
        if vname == host_name {
            let upstream_idx: int = g_vhost_indices[vi]
            let prefix: String = g_upstream_prefixes[upstream_idx]
            let plen: int = prefix.length()
            if plen == 0 {
                if vhost_catchall_idx < 0 {
                    vhost_catchall_idx = upstream_idx
                }
            } else {
                if path.startsWith(prefix) {
                    if plen > best_len {
                        best_idx = upstream_idx
                        best_len = plen
                    }
                }
            }
        }
        vi = vi + 1
    }
    if best_idx < 0 and vhost_catchall_idx >= 0 {
        best_idx = vhost_catchall_idx
    }

    // If no vhost match, try longest prefix match across non-vhost upstreams
    if best_idx < 0 {
        var i: int = 0
        while i < g_upstream_count {
            let prefix: String = g_upstream_prefixes[i]
            let plen: int = prefix.length()
            if plen > 0 {
                if path.startsWith(prefix) {
                    if plen > best_len {
                        best_idx = i
                        best_len = plen
                    }
                }
            }
            i = i + 1
        }
    }

    // No prefix match -> use default upstream
    if best_idx < 0 {
        best_idx = g_default_upstream
    }

    if best_idx < 0 {
        return http_response(503, "no upstream configured")
    }

    // Strip matched prefix from path for the backend
    var forward_path: String = path
    if best_len > 0 {
        forward_path = path.substring(best_len, path.length())
        if forward_path.length() == 0 {
            forward_path = "/"
        }
    }

    // Select backend (round-robin) and forward with pooled connection
    let cfg: ProxyConfig = g_upstream_configs[best_idx]
    let backend: Backend = select_backend(cfg)
    var tunnel_ok: int = 0
    if ssl_handle > 0 or client_fd >= 0 {
        tunnel_ok = 1
    }
    let t0: int = monotonic_us()
    let fr: Array = forward_pooled_c(best_idx, method, forward_path, headers, body, backend, tunnel_ok)
    let resp: String = fr[0]
    let sse_fd: int = fr[1]
    let t1: int = monotonic_us()

    // ── Canal SSE: se tuneliza acá y no se vuelve ────────────────────────────
    if sse_fd >= 0 {
        // (1) El claim de single-flight se libera ANTES de bloquear. Un stream
        // puede durar horas, y con el claim tomado TODO otro GET al mismo path
        // se comería el plazo de espera y después re-claimearía.
        if sf_claimed == 1 {
            singleflight_release(host_name, path)
        }
        // (2) NO se llama cache_try_store: `resp` es solo la cabecera, sin
        // cuerpo y sin longitud. Guardarla envenenaría el cache con una entrada
        // que en el próximo HIT le llega al cliente como un stream vacío que no
        // termina nunca. (Hoy el `Cache-Control: no-cache` de std/serve la haría
        // rechazar igual, pero eso es suerte: un upstream SSE que no lo mande
        // pasaría derecho.)
        // (3) Log y métrica al ABRIR, con el mismo par t0/t1 que todo el resto:
        // es la latencia hasta la cabecera, la misma semántica que para
        // cualquier pedido. Registrarlas al CERRAR metería una muestra de horas
        // en el histograma y destruiría el p99 de ese vhost para siempre.
        if sse_open_count() >= g_sse_max_tunnels {
            pool_discard(sse_fd)
            access_log(method, path, 503, t1 - t0)
            metrics_record_request(host_name, 503, t1 - t_start, 0)
            return http_response(503, "Service Unavailable: too many SSE tunnels")
        }
        access_log(method, path, 200, t1 - t0)
        metrics_record_request(host_name, 200, t1 - t_start, 0)
        if sse_tunnel(ssl_handle, client_fd, sse_fd, resp) == 1 {
            // Perdió la carrera por el cupo contra otro worker.
            return http_response(503, "Service Unavailable: too many SSE tunnels")
        }
        return ""
    }

    // Parse status code from response for logging
    var log_status: int = 0
    if resp.length() > 12 {
        // "HTTP/1.1 NNN" — status at positions 9-11
        let status_str: String = resp.substring(9, 12)
        log_status = string_to_int(status_str)
    }
    access_log(method, path, log_status, t1 - t0)

    // Intenta cachear si es GET (la lib decide si es cacheable por status +
    // Cache-Control). Responses no cacheables retornan 0 sin efecto.
    if g_cache_enabled == 1 {
        if method == "GET" {
            cache_try_store(host_name, path, resp)
            // Si tenemos el claim, liberamos para despertar waiters.
            if sf_claimed == 1 {
                singleflight_release(host_name, path)
            }
        }
    }

    metrics_record_request(host_name, log_status, t1 - t_start, 0)

    return resp
}

// Nombre viejo: sin sink, o sea sin túnel. Es el contrato que usan
// examples/standalone.nx y cualquier consumer que arme la respuesta entera antes
// de escribirla.
pub fn proxy_dispatch(raw: Array) -> String {
    return proxy_dispatch_c(raw, 0, -1)
}
